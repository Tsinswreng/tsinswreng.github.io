#import "../../_Common.typ": *
#let Terms = [
		#let T = MkTerm
		#T[護網演習][
			#P[
				護網演習是由公安部牽頭組織的實戰化網絡攻防演習，
				用來檢驗重點單位在真實攻擊下的安全防護水平。
				參演單位以央企、國企、金融、能源、運營商、醫療、教育等重點行業為主。
				演習按組織層級分國家級、省級、市級，
				部分行業也會自行組織同類演習。
			]

			#P[
				它與普通滲透測試的區別有三處。
				攻擊由多支隊伍同時發起、
				持續多日、
				事先不打招呼；
				攻防雙方都被計分，
				防守方的處置速度直接影響成績；
				攻擊目標由組織方指定，
				不由乙方自己劃定範圍。
			]

			#P[
				組織方一般提前約三週通知參演單位。
				通知內容包括參演單位要防守的目標系統清單，
				以及演習的起止時間。
			]
		]<護網演習>

		#T[紅隊][
			#P[
				紅隊是 @護網演習 中的攻擊方。
				紅隊的任務是在演習期內攻下分配給自己的目標，
				拿到可驗證的證據並提交，
				以此換取分數。
			]

			#P[
				參加演習的紅隊主要有兩類來源：
				組織方抽調的專業隊伍，
				以及參演單位或安全廠商派出的隊伍。
				一支小隊通常三到五人，
				常見的分工是一個管情報、
				一個管突破、
				一個管內網與收尾。
			]
		]<紅隊>

		#T[藍隊][
			#P[
				藍隊是 @護網演習 中的防守方，
				由參演單位自己的人員和它聘請的安全廠商工程師組成。
				藍隊的任務有三件：
				及時發現 @紅隊 的攻擊、
				及時處置、
				並把攻擊鏈還原清楚。
				三件任缺一件，
				處置的效果都要打折。
			]

			#P[
				演習期間藍隊二十四小時值守。
				攻擊不會因為提交窗口關閉而停止，
				只是成果被留到第二天白天再提交。
			]
		]<藍隊>

		#T[紅藍對抗][
			#P[
				紅藍對抗指 @紅隊 與 @藍隊 分開建制、各自計分的對抗形式。
				對抗全程有第三方在場。
				組織方負責提供演習平台、
				審核 @紅隊 提交的證據、
				記錄雙方的得分與扣分。
				裁判的裁定在演習中就是最終結果，
				所以證據的完整性與可核驗性，
				在 @紅隊 的工作裏和技術突破同樣要緊。
			]
		]<紅藍對抗>

		#T[靶標][
			#P[
				靶標是演習中 @紅隊 要攻下的目標系統。
				每支 @紅隊 有分配好的固定目標。
				組織方另設一批公共目標放進目標池，
				供所有隊伍爭奪，
				因此演習一開始，
				熱門的公共目標往往同時被好幾支隊伍盯着。
			]

			#P[
				靶標一般由參演單位自報，
				或由組織方指定。
				@紅隊 拿下靶標並提交可驗證的證據，
				經審核通過才算得分。
			]

			#P[
				「拿下」在一份具體的演習規則裏有明確定義，
				它通常不是「能訪問這個系統」，
				而是「能以可驗證的方式在靶標系統上執行操作」。
				紅隊要達成的具體目標因此有三種常見形態：
				在靶標系統上執行一條指定的命令、
				取得該系統上指定的資訊、
				或者取得該系統的管理權限。
				三種形態的分值不同，
				而判斷有沒有達成的依據是提交的證據，
				不是紅隊自己的描述。
			]
		]<靶標>

		#T[演習規則][
			#P[
				演習規則由組織方在演習開始前下發，
				規定計分方式、證據提交窗口與紅線。
				以 @紅隊 為例，
				常見的規定是提交窗口在白天若干小時內開啟，
				證據要能證明權限真實，
				並且確實來自 @靶標 系統。
			]

			#P[
				紅線是規則裏最要緊的部分：
				禁止拒絕服務攻擊、
				禁止刪改業務數據、
				禁止影響生產系統運行、
				禁止訪問與演習無關的真實個人數據。
				越過紅線的隊伍會被扣分，
				嚴重的直接取消成績。
			]
		]<演習規則>

		#T[授權][
			#P[
				授權是參演單位或組織方給 @紅隊 的書面許可，
				寫明可以攻擊的目標範圍、
				可以使用的時間窗、
				以及允許造成的影響程度。
				授權的具體內容由 @演習規則 與組織方的通知共同限定。
				@紅隊 的一切動作都以此為邊界。
			]

			#P[
				邊界情形有兩種要分清。
				一種是授權寫明了範圍，
				但某一台機器的歸屬有疑問；
				另一種是歸屬沒問題，
				但某個動作的影響程度接近上限。
				兩種情形的處理方式相同：
				停下、
				向組織方書面確認、
				留存回覆。
				紅隊的通行做法是一律以書面為準，
				因為口頭同意事後無法證明。
			]
		]<授權>
		#T[邊界設備][
			#P[
				邊界設備指部署在單位網絡與外部網絡之間、
				用來控制或檢查進出流量的設備。
				常見的有防火牆、
				遠端接入設備、
				入侵偵測與入侵防禦設備、
				郵件閘道、
				以及負載均衡。
			]
			#P[
				邊界設備在演習裏的價值有兩重。
				一是它們自己有管理面，
				管理面一旦被拿下，
				紅隊等於直接站在內網門口；
				二是它們的策略配置本身就是情報，
				讀一份防火牆規則就等於讀懂目標的網絡分區。
			]
			#P[
				補丁落後是這類設備的常態，
				成因在正文打點那一章展開。
			]
		]<邊界設備>
		#T[堡壘機][
			#P[
				堡壘機是集中管理運維權限的跳板伺服器。
				管理員不直接連目標伺服器，
				而是先登入堡壘機，
				再由堡壘機轉發到目標，
				所有操作在堡壘機上留一份會話記錄。
			]
			#P[
				它同時是防守方的審計點與紅隊的高價值目標。
				堡壘機上通常存着大量被管目標的憑據，
				拿下它等於一次拿到一整批機器的訪問權；
				反過來，
				堡壘機會話記錄是藍隊復盤攻擊路徑時最完整的一份材料。
			]
		]<堡壘機>

		#T[攻擊面][
			#P[
				攻擊面指目標單位暴露在互聯網上、
				能被外部直接觸達的一切資產與入口。
				它包括域名與子域名、
				公網 IP 段、
				開放端口、
				對外發佈的 Web 應用與接口、
				遠程接入通道、
				以及託管在雲上的服務。
			]

			#P[
				攻擊面裏最危險的部分，
				是沒有人認領的資產：
				測試環境、
				演示系統、
				開發人員自己搭的服務、
				上線時登記過而後無人維護的舊後台。
				它們通常不在運維的巡檢清單上，
				卻和生產系統連在同一個網絡裏。
			]
		]<攻擊面>

		#T[內網][
			#P[
				內網指目標單位內部、
				不直接暴露在互聯網上的網絡。
				辦公網、生產網、管理網都屬於內網。
				@攻擊面 是牆外的部分，
				內網是牆內的部分，
				兩者由邊界設備隔開。
			]

			#P[
				內網裏的機器通常不能直接訪問互聯網。
				@紅隊 進入內網之後，
				原先的攻擊機就聯繫不上目標了，
				必須另找通道把流量送出來。
			]
		]<內網>

		#T[信息收集][
			#P[
				信息收集是 @紅隊 在動手之前對 @攻擊面 的系統性摸底，
				也叫偵察。
				它包括找出目標到底有哪些資產、
				這些資產分別是甚麼、
				由誰維護、
				有沒有已知的問題。
			]

			#P[
				信息收集貫穿整個演習。
				演習開始前做的是外圍情報；
				拿到 @攻擊面 上的一個入口之後，
				還要對 @內網 再做一遍同樣的事。
			]
		]<信息收集>

		#T[影子資產][
			#P[
				影子資產指單位自己不完全掌握、
				或根本不知道存在的對外服務。
				常見來源有四類：
				開發人員的測試環境、
				業務上線時臨時開放而後無人維護的入口、
				移動端與小程序的後端介面、
				以及併購與分支機構帶進來的舊系統。
			]
			#P[
				這類資產的共同點是沒有人為它負責，
				所以沒有人給它打補丁、
				看日誌、
				做加固。
				它們是 @攻擊面 上價值最高的部分。
			]
		]<影子資產>

		#T[憑證透明度日誌][
			#P[
				憑證透明度日誌是公開的、
				只可追加的 TLS 憑證簽發記錄。
				憑證頒發機構每簽發一張公開憑證，
				通常都要把它提交到一個或多個日誌，
				日誌對任何人不設讀取條件。
				規範#footnote[見 #link("https://www.rfc-editor.org/rfc/rfc9162")[RFC 9162]。]
			]
			#P[
				對紅隊來說，
				這份日誌的用處是它記着一張憑證裏寫過的所有域名。
				一次簽發往往把一批相關域名同時寫進記錄，
				所以查一個已知域名，
				常常能順出若干個原本不知道的子域名。
			]
			#P[
				它的盲區有兩個：
				只用自簽憑證、
				不對外服務的系統不會出現在日誌裏，
				以及簽發時間早於日誌上線的憑證也不在其中。
				所以它要和被動 DNS 一類來源互相印證。
			]
		]<憑證透明度日誌>

		#T[被動DNS][
			#P[
				被動 DNS 指長期記錄域名解析結果的歷史數據庫。
				它不主動查詢，
				只是把各處觀察到的解析記錄存下來，
				所以能查到某個域名過去指向過哪些位址。
			]
			#P[
				對紅隊的用處是找已經下線但仍有記錄的資產，
				以及判斷兩個域名的位址是否曾經重合。
				它與憑證透明度日誌的盲區正好互補：
				前者管用過的名字，
				後者管用過的位址。
			]
		]<被動DNS>

		#T[自治系統號][
			#P[
				自治系統號是互聯網路由體系裏標識一個網絡的編號，
				英文縮寫是 ASN。
				一個單位、
				一家運營商、
				一家雲廠商都可能擁有若干個自治系統號，
				每個號對應一組可以整體查詢的 IP 段。
			]
			#P[
				它的用處是把「一個域名」還原成「一片網段」。
				同一個自治系統號下的位址通常屬於同一個組織，
				所以紅隊可以用它推斷目標自建機房的範圍，
				也能用它判斷某台機器是不是目標自己的資產。
			]
		]<自治系統號>

		#T[指紋][
			#P[
				指紋是資產在技術上留下的可識別特徵。
				@信息收集 走到一定程度，
				@紅隊 就能說出對面這台機器裝的是甚麼操作系統、
				甚麼中間件、
				甚麼框架、
				甚麼版本，
				甚至能猜到它是哪個廠商的哪款設備。
				這一組判斷就是指紋。
			]

			#P[
				指紋的用處是選武器。
				知道指紋之後，
				@紅隊 才知道該翻哪個組件的已知漏洞，
				不必把所有漏洞都試一遍。
			]
		]<指紋>
		#T[網頁應用防火牆][
			#P[
				網頁應用防火牆是檢查 HTTP 請求解析構並攔截攻擊特徵的設備或軟件，
				英文縮寫是 WAF。
				它部署在網站前面，
				按規則匹配請求內容，
				命中規則就阻斷。
			]
			#P[
				它對紅隊的意義是改變試探的成本。
				同一個入口在沒有 WAF 時可以反覆試，
				有 WAF 之後每次嘗試都可能被記錄並觸發攔截。
				所以紅隊要先認出目標是否有 WAF、
				是哪一款，
				再決定用甚麼節奏試。
			]
			#P[
				認它的方法在正文認指紋那一節。
			]
		]<網頁應用防火牆>
		#T[內容分發網絡][
			#P[
				內容分發網絡是把網站內容緩存在各地節點的服務，
				英文縮寫是 CDN。
				訪問者連到最近的節點，
				由節點回源或直接作答。
			]
			#P[
				它給防守方帶來一個副作用：
				從外部解析到的位址是節點的位址，
				不是目標真實伺服器的位址。
				所以紅隊若把節點位址當成目標資產去掃，
				掃到的東西與目標無關，
				既浪費時間也可能越過 @授權 邊界。
			]
		]<內容分發網絡>

		#T[弱點][
			#P[
				弱點指目標身上可以被利用的缺陷，
				範圍比漏洞寬。
				它包括軟件漏洞、
				配置錯誤、
				弱口令與默認口令、
				權限設置不當、
				以及業務邏輯上的設計缺陷。
			]

			#P[
				在 @攻擊面 上找 @弱點 靠 @指紋 指路。
				同一個弱點在不同階段的價值並不相同：
				暴露在互聯網上的弱點能換來一個入口，
				藏在 @內網 裏的弱點能換來一片區域。
			]
		]<弱點>
		#T[反序列化][
			#P[
				序列化是把記憶體裏的物件寫成一段位元組流，
				反序列化是把這段位元組流還原成物件。
				這個機制在跨程序傳遞資料時到處都用。
			]
			#P[
				它的危險來自一件事：
				還原的過程往往會按位元組流裏寫的類型資訊去建立物件，
				甚至呼叫物件自己的還原方法。
				於是「能控制位元組流」就等於「能影響對方建立甚麼物件、
				執行甚麼程式碼」。
			]
			#P[
				危險的觸發點通常在資料要跨程序邊界的地方：
				工作階段資料、
				快取、
				訊息佇列、
				以及遠端呼叫。
				這些位置有一個共同特徵，
				就是資料由一端寫入、
				由另一端還原，
				而寫入端未必可信。
			]
		]<反序列化>
		#T[越權訪問][
			#P[
				越權訪問指使用者做了自己權限範圍之外的事。
				它分兩類。
				水平越權是同級別使用者之間互相訪問對方的資料，
				例如把查詢裏的使用者編號換成別人的；
				垂直越權是低權限使用者做了高權限的事，
				例如普通帳號存取了管理介面。
			]
			#P[
				它與其他弱點的差別在於，
				它通常不需要任何技術鏈，
				只需要改一個參數或直接訪問一個沒有做檢查的位址。
				所以它在真實系統裏的出現頻率遠高於外界的預期。
			]
		]<越權訪問>
		#T[服務端請求偽造][
			#P[
				服務端請求偽造指紅隊讓目標伺服器代替自己去訪問一個位址，
				英文縮寫是 SSRF。
				觸發點是那些由使用者提供位址、
				由伺服器去抓取的功能，
				例如圖片抓取、
				網址預覽、
				檔案匯入。
			]
			#P[
				它的價值取決於伺服器能訪問到甚麼。
				若伺服器能訪問內網位址，
				這個弱點就從一個功能缺陷變成進入 @內網 的入口，
				這是它被單獨列出來的原因。
			]
		]<服務端請求偽造>

		#T[社工釣魚][
			#P[
				社工釣魚是從人入手取得訪問權限的手法。
				常見形式是向目標單位的員工投遞偽裝過的郵件，
				誘使其點擊鏈接、
				打開附件、
				或在仿冒的登錄頁上填寫帳號口令。
			]

			#P[
				@信息收集 階段拿到的員工姓名、崗位與郵箱命名規則，
				在這一步直接變成投遞清單。
				釣魚的價值在於它繞開全部邊界設備。
				防禦方把防火牆、WAF、入侵檢測都部署在互聯網入口，
				而釣魚郵件進的是員工的收件箱。
			]
		]<社工釣魚>
		#T[誘餌][
			#P[
				誘餌指釣魚投遞裏給人看的那一層東西，
				包括郵件正文、
				附件、
				以及連結指向的頁面。
				它與 @載荷 是兩件事：
				誘餌決定對方會不會動手，
				載荷決定動手之後發生甚麼。
			]
			#P[
				誘餌的成敗取決於它說的事情在對方的工作裏合不合理，
				與技術關係不大。
				同一份載荷換一個誘餌帶來的成敗差別，
				通常大於同一份誘餌換一份載荷。
			]
		]<誘餌>
		#T[1day與Nday][
			#P[
				1day 指剛公開、
				補丁剛發布不久、
				多數目標還沒來得及修的漏洞；
				Nday 指已經公開很久、
				補丁早已發布、
				但仍有相當數量目標沒有修的漏洞。
				兩個詞都是紅隊內部的叫法，
				不是嚴格的學術術語。
			]
			#P[
				兩者的用法差別在正文漏洞的取捨那一節。
				要記住的是它們的分界不在漏洞本身，
				而在目標修沒修。
			]
		]<1day與Nday>
		#T[口令噴灑][
			#P[
				口令噴灑指用少量常見口令去試大量帳號，
				每個帳號只試一兩次。
				它與逐個帳號窮舉的差別在觸發鎖定的機率。
				帳號鎖定策略通常按同一帳號連續失敗次數計數，
				每個帳號只試一次就不會把任何一個帳號試到鎖定。
			]
		]<口令噴灑>
		#T[撞庫][
			#P[
				撞庫指拿別處洩漏的帳號口令組合，
				去試目標單位的系統。
				它的前提假設是人會在多個系統上重複使用同一套口令。
			]
			#P[
				它與口令噴灑的差別在偵測方式上。
				撞庫的特徵是大量不同帳號、
				每個帳號的口令都不同且都失敗；
				口令噴灑的特徵是大量帳號都試同一個口令。
				防守方這兩條規則要分開寫。
			]
		]<撞庫>
		#T[憑據填充][
			#P[
				憑據填充指把已經拿到的憑據拿去試其他系統。
				它與撞庫的差別在憑據的來源：
				撞庫用的是別處洩漏的，
				憑據填充用的是自己在本次行動中取得的。
			]
			#P[
				這一步是內網擴散的主要動力。
				一次成功的填充就把一台機器的存取權變成一批機器的存取權，
				所以它的收益遠高於在同一個系統上繼續找漏洞。
			]
		]<憑據填充>
		#T[多因素認證][
			#P[
				多因素認證指登入時要求兩類以上不同性質的憑證，
				英文縮寫是 MFA。
				不同性質是關鍵：
				口令加另一個口令不算多因素，
				口令加一次性的動態碼或一把私鑰才算。
				分級與要求#footnote[見 #link("https://pages.nist.gov/800-63-4/sp800-63b.html")[NIST SP 800-63B-4]，該修訂版在二零二五年發佈，取代了此前的 SP 800-63-3。]
			]
			#P[
				它對紅隊的直接影響是口令那條路被截斷：
				知道口令也登不進去。
				但它並不是不可繞，
				繞法不在於破解第二個因素，
				而在於讓第二個因素驗證通過的那一刻被別人利用，
				詳見正文弱口令那一節。
			]
		]<多因素認證>

		#T[打點][
			#P[
				打點指在目標系統上取得第一個可控的執行點。
				它是 @紅隊 在演習裏真正意義上的開始。
				在打點成功之前，
				@紅隊 做的都是準備。
			]

			#P[
				打點通常走三條路：
				一是 @攻擊面 上存在 @弱點 的 Web 應用與邊界設備，
				二是 @社工釣魚 換來的員工終端與帳號，
				三是供應鏈與第三方運維。
				三條路的目標一致，
				都是為了拿到一個立足點。
			]
		]<打點>

		#T[立足點][
			#P[
				立足點是 @打點 成功之後，
				@紅隊 在目標系統上獲得的那個可控的執行點。
				表現形式可能是服務器上的一個後門文件、
				一段注入到正常進程裏的代碼、
				也可能只是一個能用的帳號。
			]

			#P[
				立足點有三個必須解決的問題：
				能不能執行命令、
				能不能穩定存活、
				能不能反覆回來。
				只滿足第一條的立足點往往活不過半天。
			]
		]<立足點>

		#T[載荷][
			#P[
				載荷是紅隊投放到目標系統上、
				由目標自己執行的那段內容的統稱。
				它是一個泛稱，
				具體分三層：
				@誘餌 那一層給人看，
				@加載器 那一層負責把東西弄起來，
				@被控端 那一層長期留在機器上聽 @命令與控制 指揮。
			]
			#P[
				三層的壽命不同，
				誘餌投遞一次就廢掉，
				加載器通常在數小時內被端點防護記住，
				被控端要活到演習結束。
				所以三者的投入與更新節奏也不同。
			]
		]<載荷>

		#T[加載器][
			#P[
				加載器是 @載荷 裏第一個跑起來的那一段。
				它的任務有三件：
				判斷自己在甚麼環境裏、
				把真正幹活的內容還原出來、
				以及換一個已經被信任的宿主去執行它。
			]
			#P[
				它與 @被控端 的分界在於是否長期存在。
				幹完就消失的是加載器；
				留下來維持 @命令與控制 通道的是被控端。
			]
			#P[
				它的痕跡落在終端上，
				而且是最容易被記錄下來的那一層，
				所以它也是三層裏最需要反覆更換的一層。
			]
		]<加載器>

		#T[被控端][
			#P[
				被控端是 @載荷 裏長期留在目標機器上、
				主動回連控制端並接受指令的那一段。
				它的功能有五件：
				回連、
				取指令、
				執行、
				回報、
				以及自我保護。
			]
			#P[
				它與 @立足點 的關係是：
				立足點描述的是紅隊在目標上有一個可控的執行位置，
				被控端是維持這個位置最常見的實現。
				後續的取 @憑據 、
				@提權 與 @橫向移動 都從它開始。
			]
			#P[
				它的可見性與存活期成反比：
				要在目標機器上長期存在，
				就必須有某些東西是持續的，
				而持續的東西會在日誌或基線裏形成穩定的痕跡。
			]
		]<被控端>

		#T[代碼簽名][
			#P[
				代碼簽名指用一個由受信任機構簽發的證書，
				為程式檔案附上一段可驗證來源的簽章。
				作業系統與終端防護會據此調整對這個檔案的初始判斷，
				包括信譽評級、
				使用者看到的警告、
				以及部分策略的放行。
			]
			#P[
				它只影響檔案層這一關，
				程式跑起來之後的行為該被發現還是會被發現。
				所以它的作用是降低進門的阻力，
				不是進門之後的安全。
			]
			#P[
				簽名的痕跡在證書本身：
				證書有實名審核、
				有簽發紀錄，
				被濫用之後會被吊銷，
				因此紅隊用哪一類證書是一個要事先想清楚的決定。
			]
		]<代碼簽名>

		#T[沙箱][
			#P[
				沙箱指防守方或分析平台用來在隔離環境裏執行可疑檔案、
				並記錄其行為的系統。
				它與真實目標環境的差別在於：
				沒有真實使用者在用、
				硬體與系統設定較為固定、
				以及執行時間通常有限。
			]
			#P[
				對紅隊的意義有兩重。
				一是它會記錄 @載荷 在隔離環境裏的完整行為，
				於是同一版載荷用第二次就會被認出來；
				二是它能被用來排除明顯有問題的載荷，
				因為在沙箱裏過得了不代表目標上過得了，
				沙箱裏過不了則幾乎可以確定目標上也過不了。
			]
		]<沙箱>

		#T[重定向器][
			#P[
				重定向器是 @命令與控制 架構裏的一台中間機器。
				@被控端 連的是它，
				它再把流量轉給真正處理指令的控制端。
			]
			#P[
				它的作用是讓被發現時的損失變小，
				而不是讓自己被發現不了：
				防守方順著流量查到的是這台機器，
				上面沒有任何東西，
				處置它只讓紅隊損失一跳；
				同時因為被控端記住的位址沒變，
				紅隊可以在不換載荷的情況下更換後端。
			]
			#P[
				代價是多了一跳，
				而且它的位址遲早會被查出來。
			]
		]<重定向器>

		#T[命令與控制][
			#P[
				命令與控制指 @紅隊 與 @立足點 之間傳遞指令和數據的通道，
				英文縮寫是 C2。
				@立足點 只解決「能執行一次」的問題，
				命令與控制解決的是「能一直指揮」的問題。
			]

			#P[
				一條合格的 C2 通道要能扛住中斷、
				要能換協議換端口、
				要能藏進正常流量裏。
				演習中常見的做法是把 C2 流量混進 HTTPS 或 DNS 查詢，
				因為這兩類流量在企業網絡裏幾乎不可能被完全封死。
			]
		]<命令與控制>
		#T[域前置][
			#P[
				域前置指在一條 TLS 連線上，
				讓網絡中間看到的主機名與實際處理請求的主機名不一致。
				中間設備只能看到加密連線外層的那個名字，
				所以按名字做的封鎖會失效。
			]
			#P[
				它靠的是大型內容分發網絡同時承載大量客戶域名的特性。
				這條路的可用性取決於服務商的策略，
				近年多數大廠已明確禁止，
				所以它是一種會過時的手法，
				不是穩定通道。
			]
		]<域前置>
		#T[隱蔽通道][
			#P[
				隱蔽通道指把 @命令與控制 流量藏進看起來正常的流量裏。
				選哪種流量做載體，
				判斷標準是它在目標網絡裏是否必須放行。
				常見載體是 HTTPS、
				DNS 查詢、
				以及各類雲服務與協作平臺的介面。
			]
			#P[
				MITRE ATT&CK 把這類做法歸在應用層協議與代理兩族，
				#footnote[見 #link("https://attack.mitre.org/techniques/T1071/")[T1071] 與 #link("https://attack.mitre.org/techniques/T1090/")[T1090]。]
			]
		]<隱蔽通道>
		#T[心跳與抖動][
			#P[
				心跳指被控端按固定間隔回連控制端，
				用來確認通道還在、
				順便取回指令。
				抖動指把這個間隔加上隨機量，
				讓回連的時間點不呈現固定週期。
			]
			#P[
				為甚麼要抖動：
				固定週期的回連在流量統計上是一個明顯的節律，
				很容易被基線模型挑出來；
				加了隨機量之後，
				單看時間間隔就沒有可用的特徵。
				代價是指令的下發延遲變大。
			]
		]<心跳與抖動>
		#T[進程注入][
			#P[
				進程注入指把一段程式碼寫進另一個已經在運行的進程，
				讓它以那個進程的身份執行。
				常見做法是在目標進程裏分配記憶體、
				寫入內容、
				再讓它開一條執行緒去跑。
			]
			#P[
				紅隊用它有兩個目的：
				一是借用一個本身被信任的進程，
				二是讓自己的程式碼不出現在磁碟上。
				它的痕跡主要留在跨進程的記憶體操作與執行緒建立上，
				端點防護正是據此偵測的。
			]
		]<進程注入>
		#T[白利用][
			#P[
				白利用指不帶自己的程式，
				直接用系統自帶的、
				本來就有正當用途的工具完成動作。
				腳本宿主、
				計劃任務工具、
				遠端管理工具、
				以及各類系統管理程式都屬於這一類。
			]
			#P[
				這種做法的難點在防守方：
				被呼叫的工具是系統的一部分，
				按檔案信譽攔不住。
				可用的工具清單有公開整理，
				#footnote[見 #link("https://lolbas-project.github.io/")[LOLBAS]。]
			]
		]<白利用>
		#T[端點偵測與回應][
			#P[
				端點偵測與回應是裝在終端上、
				記錄行為而不只比對檔案特徵的防護軟件，
				英文縮寫是 EDR。
				它記程序的父子關係、
				跨進程操作、
				以及命令列內容，
				所以對白利用與進程注入這類做法比傳統防毒更敏感。
			]
		]<端點偵測與回應>

		#T[提權][
			#P[
				提權指把已經到手的低權限帳號提升為管理員或系統權限。
				@立足點 往往來得並不好看。
				Web 服務以普通用戶身份運行，
				拿下的帳號只能訪問一個目錄。
				提權就是把這個身份換成能讀寫全盤的那一個。
			]

			#P[
				提權成功的直接收益有兩個：
				一是能動系統配置，
				二是能讀到本機保存的帳號口令與密碼哈希。
				後者比前者重要得多。
			]
		]<提權>

		#T[提權面][
			#P[
				提權面指一台機器上一切能讓低權限身份取得更高權限的地方。
				它的範圍比 @弱點 寬，
				既包括設定錯誤與權限配置不當，
				也包括本身合法、
				卻被授予了超出需要的權力的功能。
			]
			#P[
				一條提權面要同時滿足三個條件：
				有一個會以更高權限運行的主體，
				這個主體會去讀取或執行某個東西，
				而那個東西當前身份能改。
				三個條件缺一個，
				這條路就不通。
			]
			#P[
				紅隊清點提權面時按主體的名目走：
				服務、
				計劃任務、
				核心驅動、
				定時任務、
				以及被授予額外權力的檔案。
				這幾類在兩個操作系統上的叫法不同，
				結構相同。
			]
		]<提權面>

		#T[服務設定缺陷][
			#P[
				服務設定缺陷指 Windows 服務的設定、
				或它所依賴的路徑，
				落在當前身份可改的範圍裏。
				服務通常以系統身份運行，
				所以改動服務設定或它所執行的檔案，
				等於讓系統身份替紅隊執行。
			]
			#P[
				常見情形有三種：
				服務可執行檔的路徑沒有加引號，
				而路徑上有一段目錄可寫；
				服務可執行檔所在的目錄可寫；
				以及服務物件本身的權限設定允許普通使用者改設定。
			]
			#P[
				它與目錄權限那一類同源，
				差別在改的對象不同：
				這一類改的是服務指向哪一個檔案。
			]
		]<服務設定缺陷>

		#T[目錄權限缺陷][
			#P[
				目錄權限缺陷指一個高權限程序在運行時會去讀取或執行的位置，
				落在當前身份可寫的目錄裏。
				程序按名字去找檔案時，
				若搜尋順序上有一段目錄可寫，
				紅隊在那裏放一個同名的檔案，
				程序就會讀到或執行到它。
			]
			#P[
				它與 @服務設定缺陷 同源，
				都是高權限主體碰到了低權限身份能改的東西。
				差別在這一類不必改任何設定，
				只要那個位置可寫。
			]
			#P[
				判斷的關鍵不是目錄可不可寫，
				而是程序會不會真的去那裏找。
			]
		]<目錄權限缺陷>

		#T[核心驅動][
			#P[
				核心驅動是運行在 Windows 核心態的程式，
				它的權限與作業系統同級。
				普通使用者無權載入驅動，
				所以這一類提權面要靠兩條路繞過去。
			]
			#P[
				一條是用一個已簽章但有缺陷的驅動：
				簽章讓它通過檢查，
				缺陷讓它替紅隊做事。
				另一條是利用核心本身的漏洞，
				在核心態執行任意程式碼。
			]
			#P[
				它與 @提權面 裏其他幾類不同。
				其他幾類是設定被人用錯了，
				這一類本質上是 @弱點 ，
				需要版本匹配，
				而且一旦失手會直接把機器帶下線。
			]
		]<核心驅動>

		#T[令牌][
			#P[
				令牌是 Windows 在一個程序登入之後發給它的身份憑證。
				令牌裏寫着這個身份是誰、
				屬於哪些群組、
				以及持有一組甚麼特權，
				後續每一次操作都憑令牌判斷權限。
			]
			#P[
				令牌分兩種。
				主令牌代表登入的那個使用者；
				模擬令牌代表被模擬的另一個身份，
				一個執行緒可以在模擬狀態下以別人的身份操作。
				正因為有模擬，
				拿到一個高權限的令牌就等於拿到了那個身份。
			]
		]<令牌>

		#T[令牌竊取][
			#P[
				令牌竊取指把一個高權限程序持有的 @令牌 據為己有，
				從而以那個身份操作。
			]
			#P[
				它與 @提權 的關係是手段與目的。
				提權的目標之一是拿到更高權限的令牌，
				而拿到令牌之後往往就不必再做提權動作了。
			]
		]<令牌竊取>

		#T[特殊權限位元][
			#P[
				特殊權限位元指可執行檔上的一組標記，
				最要緊的兩個是 setuid 與 setgid。
				一個帶 setuid 的檔案被執行時，
				執行的身份是檔案的擁有者，
				而不是呼叫它的那個使用者。
			]
			#P[
				系統裏本來就有一些必須帶這個位元的程式，
				所以問題不在位元本身，
				而在一個以更高身份運行、
				又能被使用者影響其行為的程式：
				它會讀取使用者給的檔案、
				接受使用者給的參數、
				或者去呼叫使用者能控制的另一個程式。
			]
			#P[
				它與能力位元那一類講的是同一個問題的兩種做法，
				差別在位元是全有全無地換一個身份，
				能力是把高權限拆成一項一項單獨授予。
				這一類是 @提權面 的一種。
			]
		]<特殊權限位元>

		#T[命令提權工具][
			#P[
				命令提權工具指讓指定使用者以指定身份執行指定命令的工具，
				在 Linux 上最常見的是 sudo。
				規則寫在一份設定檔以及它引入的目錄裏，
				每一條規則說明誰、
				可以以誰的身份、
				執行哪一條命令。
			]
			#P[
				它成為提權面的原因有三處。
				被允許執行的命令本身能執行別的命令或開一個 shell；
				規則用了通配符或前綴比對，
				實際允許的範圍比寫出來的大；
				以及規則保留了呼叫者的環境變數，
				而某些變數會被程式讀取。
			]
			#P[
				還有一類設定是不要求口令，
				它降低的不是權限，
				是拿到權限的門檻。
				這一類是 @提權面 的一種。
			]
		]<命令提權工具>

		#T[定時任務][
			#P[
				定時任務是 Linux 按時間表自動執行命令的機制，
				常見形態有 cron、
				一次性的 at、
				以及以服務管理員為基礎的定時器。
			]
			#P[
				它與 Windows 上的計劃任務是同一件事的兩種實現，
				缺陷的形態也相同：
				被執行的腳本本身可寫、
				腳本所在目錄可寫，
				或者時間表的定義檔本身可寫。
			]
			#P[
				它另有一處設定特有的問題：
				定時任務執行時的搜尋路徑比互動式 shell 短，
				腳本裏若按名字呼叫外部命令，
				在被搜尋的目錄裏放一個同名程式就能把呼叫接過來。
			]
		]<定時任務>

		#T[核心漏洞][
			#P[
				核心漏洞指作業系統核心裏的缺陷，
				利用它可以直接取得系統的最高權限。
				它的成因類型包括核心介面對使用者傳入的參數校驗不足、
				競態條件、
				以及記憶體管理上的錯誤。
			]
			#P[
				它與 @核心驅動 是核心態這一類提權面在兩個系統上的兩個名字。
				與其他幾類相比，
				這一類的成本與風險都高：
				需要版本匹配，
				利用過程不穩定，
				失敗的後果往往是機器崩潰或重啓。
			]
			#P[
				所以在紅隊的次序裏，
				它排在最後，
				只在其他路走不通時才考慮。
			]
		]<核心漏洞>

		#T[能力位元][
			#P[
				能力位元是 Linux 把最高權限拆成一項一項之後的產物。
				原本只有最高權限與普通使用者兩種身份，
				有了能力位元之後，
				可以單獨把某一項權力授予一個程式，
				例如讀取任意檔案、
				切換使用者身份、
				或管理網路設定。
			]
			#P[
				它成為提權面的原因是：
				能力集裏有幾項單獨就等於完整的控制權，
				而被授予這些能力的檔案，
				往往是廠商或運維為了省事加上去的。
			]
			#P[
				它與 @特殊權限位元 解決的是同一個問題，
				差別在授予的粒度。
				兩者的風險相同，
				都是把不需要的權力給了出去。
			]
		]<能力位元>

		#T[憑據轉儲][
			#P[
				憑據轉儲指把作業系統與相關服務保存在本機的憑據取出來，
				包括記憶體快取中的身份資訊、
				本機帳號資料庫裏的口令雜湊、
				以及各類服務自己存的憑據。
			]
			#P[
				它是 @提權 之後最優先做的動作，
				因為一台機器上的憑據往往能用在一批機器上。
				MITRE ATT&CK 把這類做法歸在 T1003，
				#footnote[見 #link("https://attack.mitre.org/techniques/T1003/")[OS Credential Dumping]。]
			]
		]<憑據轉儲>

		#T[憑據][
			#P[
				憑據指證明身份的東西，
				包括帳號與口令、
				口令的哈希值、
				Kerberos 票據、
				以及配置文件與腳本裏明文保存的密碼。
				@立足點 是位置，
				憑據是鑰匙。
			]

			#P[
				憑據比漏洞值錢，
				原因有三個。
				一個漏洞通常只在一台機器上有效，
				而憑據可以用在目標單位的許多系統上；
				不少口令在 @內網 裏被多台機器共用；
				用憑據登錄產生的流量完全合法，
				防守方很難從協議層面把它和正常運維區分開。
			]
		]<憑據>

		#T[域與域控][
			#P[
				域是 Windows 網絡中集中管理帳號與權限的目錄服務，
				域控是運行這套服務的服務器。
				在企業 @內網 裏，
				域控保存着全網的帳號、
				口令哈希、
				以及誰能用哪台機器的授權規則。
			]

			#P[
				對 @紅隊 來說，
				@內網 裏的域控是最有價值的一台機器。
				拿到 @憑據 之後，
				絕大多數橫向移動都要經過域的認證機制。
				控制域控，
				等於拿到整個 @內網 的萬能鑰匙。
			]
		]<域與域控>
		#T[票據][
			#P[
				票據是 @域與域控 環境裏用來證明身份的憑證。
				使用者通過認證之後拿到一張票據，
				之後訪問域內資源時出示這張票據，
				不必每次都重輸口令。
			]
			#P[
				對紅隊來說票據有兩個特點。
				一是它可以直接被使用，
				不需要還原成口令；
				二是它有有效期，
				過期之後要重新取得，
				所以拿到票據之後的動作要在有效期內完成。
			]
		]<票據>

		#T[橫向移動][
			#P[
				橫向移動指 @紅隊 從已有的機器出發，
				用同樣的 @憑據 去控制 @內網 裏更多機器的過程。
				它是演習中持續時間最長、
				最能體現技術水平的環節。
			]

			#P[
				橫向移動很少靠新漏洞，
				多數時候靠的是目標自己的管理工具：
				遠程桌面、
				文件共享、
				遠程過程調用、
				計劃任務、
				以及各種自動化運維腳本。
				這些工具本來就是為了方便管理員批量操作而存在的。
			]
		]<橫向移動>

		#T[隧道與代理][
			#P[
				隧道與代理是 @紅隊 在自己與 @內網 之間搭的一條中轉通道。
				@內網 裏的機器通常不能直接訪問互聯網，
				@紅隊 的攻擊機也在外面進不來，
				兩邊需要一個中間人替它們轉發流量。
			]

			#P[
				常見做法是在已經控制的邊緣機器上開一個監聽端口，
				把 @內網 的流量包進合法的出網請求裏送到攻擊機，
				或者讓攻擊機的指令通過這條通道分發到 @內網 各處。
				這條通道通常與 @命令與控制 通道一起維護。
				隧道打通與否，
				直接決定 @紅隊 能走多遠。
			]
		]<隧道與代理>
		#T[隔離區][
			#P[
				隔離區指介於外網與 @內網 之間、
				用來放置對外服務的那一段網絡，
				也叫 DMZ。
				對外提供服務的伺服器放在這裏，
				它與真正的內網之間再隔一道策略。
			]
			#P[
				紅隊拿下隔離區裏的機器並不等於進入內網，
				兩者之間往往還有一次跨區跳躍。
				這也是為甚麼從 @邊界設備 進去的收益比從對外業務系統進去更高，
				邊界設備本身常常同時連着兩個區。
			]
		]<隔離區>
		#T[噪音預算][
			#P[
				噪音預算指一次行動允許在目標那裏留下多少可被發現的痕跡。
				它是紅隊自己給自己定的約束，
				不是防守方的概念。
			]
			#P[
				為甚麼需要這個約束：
				在互聯網上做情報收集時，
				掃描量大、
				被發現也無所謂；
				進到 @內網 之後，
				一次全網段掃描就可能直接引來處置，
				把已經拿下的 @立足點 賠進去。
				所以內網的每一步都要先算這一步要花掉多少噪音、
				自己還剩多少。
			]
		]<噪音預算>
		#T[組態管理工具][
			#P[
				組態管理工具指用來批量下發設定與執行腳本到大量機器的運維系統。
				這類工具在設計上就要能在一台機器上對很多機器下命令，
				所以它天然具備橫向執行的能力。
			]
			#P[
				紅隊在意它還有一個原因：
				它的設定檔與下發的腳本裏常常直接寫着高權限帳號。
				拿到這些檔案等於同時拿到橫向通道與憑據。
			]
		]<組態管理工具>

		#T[特權帳號][
			#P[
				特權帳號指在域內或在本機上擁有管理權限的帳號，
				包括域管理員、
				本機管理員、
				以及各類服務帳號。
			]
			#P[
				它們是內網階段的首要目標，
				原因是 @憑據 讓攻擊者可以在大量機器上活動，
				而特權帳號本身的活動範圍往往就直接覆蓋一整片網絡。
			]
		]<特權帳號>

		#T[權限維持][
			#P[
				權限維持指 @紅隊 在已經拿下的機器上留下能長期反覆回來的入口。
				演習期間 @藍隊 會不斷排查，
				被發現的 @立足點 會被清掉，
				所以 @紅隊 在關鍵機器上通常不止留一條路。
			]

			#P[
				常見的落腳點包括新增的本地帳號與域帳號、
				計劃任務、
				系統服務、
				以及各類 Web 中間件的後門。
				留在 @域與域控 上的入口價值最高，
				因為它同時意味着整片 @內網 的訪問權。
			]
		]<權限維持>

		#T[痕跡清理][
			#P[
				痕跡清理指 @紅隊 在收尾時處理自己留下的記錄，
				也叫打掃戰場。
				要處理的東西包括上傳的工具與樣本文件、
				新增的帳號與計劃任務、
				被修改的配置、
				以及系統日誌與安全設備日誌裏的相關條目。
			]

			#P[
				清理的目的首先是保住入口，
				避免 @立足點 與 @權限維持 的線索被 @藍隊 順着查出來。
				它與計分的關係是另一回事，
				兩者之間的取捨寫在正文站樁與打掃那一節。
			]
		]<痕跡清理>
		#T[蜜罐][
			#P[
				蜜罐指防守方故意放置的、
				看起來有價值但實際無人使用的系統或帳號。
				它不對外提供業務，
				所以任何對它的訪問都是異常的。
			]
			#P[
				它的價值不在攔截，
				在於發現。
				一個蜜罐被觸碰，
				藍隊立刻知道有人已經進來了，
				並且能拿到攻擊者的手法與來源。
				對紅隊來說，
				過於容易拿下本身就是一個應當放棄的信號。
			]
		]<蜜罐>

		#T[舉證與報告][
			#P[
				舉證指 @紅隊 把拿下的權限整理成組織方可以核驗的證據，
				再做提交。
				證據通常包括 @靶標 系統上的命令執行截圖、
				系統信息頁面、
				以及能證明操作發生在演習時間窗內的記錄。
				@演習規則 對提交窗口有明確規定，
				過了窗口的成果只能留到下一次。
			]

			#P[
				報告是演習結束後交的另一份東西，
				內容包括攻擊路徑、
				用到的 @弱點 、
				以及 @藍隊 在哪些環節本可以攔住卻沒有攔住。
				紅隊的報告與藍隊的復盤合起來，
				才是一次演習對參演單位的真正價值。
			]
		]<舉證與報告>
	]

// 專題篇《外部攻擊面測繪》的詞條。
// 與上面的 Terms 分開展開：
// 主篇只展開 Terms，該專題篇先展開 Terms 再展開本表，
// 這樣主篇的術語表不會多出它正文沒有引用過的條目。
// 排列順序是這些詞條在該篇正文裏第一次出現的順序。
#let ReconTerms = [
		#let T = MkTerm

		#T[攻擊面測繪][
			#P[
				攻擊面測繪指把目標單位暴露在互聯網上、
				可被外部觸達的資產系統性列全的過程。
				它是 @信息收集 在外圍那一段的具體做法，
				產出是 @資產地圖 與 @入口清單 兩份東西。
			]
			#P[
				它的範圍限於牆外，
				與進入 @內網 之後的第二輪摸底是兩回事。
			]
		]<攻擊面測繪>

		#T[被動測繪][
			#P[
				被動測繪指不向目標發送任何查詢、
				只讀取第三方既有記錄的測繪方式。
				來源包括 @憑證透明度日誌 、
				@被動DNS 、
				互聯網測繪平台保存的掃描結果、
				以及搜索引擎與代碼倉庫的快取。
			]
			#P[
				它與主動列舉的差別在痕跡：
				被動測繪在目標那一側不產生流量。
				邊界情形是它的記錄可能過期，
				所以讀到的內容要帶時間戳。
			]
		]<被動測繪>

		#T[字典爆破][
			#P[
				字典爆破指拿一份常見子域名字典逐個發出解析查詢、
				按能不能解析出位址判斷名字是否存在的做法。
				置換爆破是它的變體，
				在已知名字上改寫環境字尾、
				序號與分隔符，
				而不是在空白處猜。
			]
			#P[
				它與別的來源最大的差別是它必定向目標發送查詢。
				邊界情形是目標若開了泛解析，
				所有不存在的名字都會返回同一個位址，
				它的結果就失去意義。
			]
		]<字典爆破>

		#T[區域傳送][
			#P[
				區域傳送指把一個域名區域內的全部記錄一次性從權威域名服務器取回的操作，
				查詢類型的縮寫是 AXFR。
				規範#footnote[見 #link("https://www.rfc-editor.org/rfc/rfc5936")[RFC 5936]。]
			]
			#P[
				設定不當時服務器會接受來自任意來源的區域傳送請求，
				於是區域內的主機名、
				別名與郵件交換記錄一次全部洩漏。
				現代域名服務器默認拒絕這類請求，
				所以它命中率低。
			]
		]<區域傳送>

		#T[域名註冊資訊][
			#P[
				域名註冊資訊指域名註冊時向註冊機構登記的資料，
				包括註冊人、
				註冊商、
				名稱服務器、
				以及創建與到期時間。
				查詢協議早期是 whois，
				近年逐步換成結構化的 RDAP。
				#footnote[見 #link("https://www.rfc-editor.org/rfc/rfc3912")[RFC 3912] 與 #link("https://www.rfc-editor.org/rfc/rfc7483")[RFC 7483]。]
			]
			#P[
				註冊人那一欄現在多半被隱私保護遮蔽，
				所以它的主要用途落在名稱服務器與時間兩欄上。
			]
		]<域名註冊資訊>

		#T[備案信息][
			#P[
				備案信息指在我國境內提供服務的網站向主管部門登記主辦單位與域名後形成的公開記錄，
				登記結果可按單位名稱反查。
			]
			#P[
				它的入口是單位名稱，
				與其他來源以域名為入口的方向相反。
				邊界情形是它只覆蓋按要求登記過的網站，
				用境外主機與境外域名的系統不在其中。
			]
		]<備案信息>

		#T[反向解析][
			#P[
				反向解析指用位址反查名字的查詢，
				結果是一條指針記錄，
				英文縮寫是 PTR。
				它與正向解析走兩套獨立的設定，
				所以反向記錄裏的名字常常不出現在正向清單裏。
			]
			#P[
				前綴短於一個字節邊界時的委派方式在標準文本裏另有規定#footnote[見 #link("https://www.rfc-editor.org/rfc/rfc2317")[RFC 2317]。]
			]
		]<反向解析>

		#T[端口掃描][
			#P[
				端口掃描指逐個端口嘗試連接、
				據此判斷遠端主機上哪些端口有服務在監聽。
				按端口範圍分兩種做法：
				全端口覆蓋一到六五五三五，
				常見端口只覆蓋一份數百條的清單。
			]
			#P[
				按協議分 TCP 與 UDP 兩種。
				UDP 沒有連接，
				沒有回應無法區分端口關閉、
				包被丟棄與服務按協議不應回覆這三種情形。
			]
		]<端口掃描>

		#T[服務識別][
			#P[
				服務識別指判斷某個開放端口後面跑着甚麼服務、
				以及是甚麼版本。
				證據分三層：
				服務自報的問候資訊、
				主動探測得到的應答、
				以及加密層與憑證的協商結果。
			]
			#P[
				端口號本身不足以判定服務，
				因為服務可以跑在非默認端口上，
				中間也可能有一層代理把請求轉給別的服務。
			]
		]<服務識別>

		#T[雲暴露面][
			#P[
				雲暴露面指單位在雲上與軟件即服務平台上開出來、
				且可從互聯網觸達的資源與設定。
				檢查的重點有四項：
				對象儲存的匿名讀寫權限、
				雲主機安全組開放的端口、
				被提交到公開倉庫的介面金鑰、
				以及軟件即服務租戶設定裏的對外共享開關。
			]
			#P[
				它與自建機房的暴露面差別在判斷方式：
				雲上的暴露多數是設定問題，
				可以從外部觀察出來。
			]
		]<雲暴露面>

		#T[組織結構測繪][
			#P[
				組織結構測繪指從公開資訊裏還原目標單位的部門與職責、
				技術棧、
				以及人員與對外聯絡位址。
				產出是三張圖，
				它們分別服務於選目標、
				猜技術棧、
				以及準備投遞清單。
			]
		]<組織結構測繪>

		#T[郵箱命名規則][
			#P[
				郵箱命名規則指一個單位內部郵件位址的拼寫格式，
				常見的有姓名全拼、
				姓加名首字母、
				工號、
				以及英文名加數字。
			]
			#P[
				規則是從公開的對外聯絡位址取樣歸納出來的。
				按規則生成的位址屬於推測，
				因為重名、
				改名與外派人員都會是例外。
			]
		]<郵箱命名規則>

		#T[洩漏憑據庫][
			#P[
				洩漏憑據庫指歷史上從各處洩漏出來、
				並在互聯網上流傳的帳號與口令資料集合。
				它的價值不在於裡面的記錄直接可用，
				而在於它能反映一個人慣用的口令構造方式。
			]
			#P[
				邊界情形是其中絕大多數記錄與演習目標無關，
				取用範圍必須先與 @授權 對齊。
			]
		]<洩漏憑據庫>

		#T[指紋載體][
			#P[
				指紋載體指能透露實現資訊的可觀察特徵，
				常見的有九類：
				回應標頭、
				Cookie 的名字與結構、
				默認頁與報錯頁、
				靜態資源的路徑與命名規律、
				網頁圖示的雜湊值、
				憑證的簽發者與主題欄位、
				網絡棧的行為特徵、
				前端打包產物的結構、
				以及端口的默認值。
			]
			#P[
				九類的可靠度差別很大，
				網絡棧行為與打包產物最難改，
				自報的字串最容易改。
			]
		]<指紋載體>

		#T[版本判定][
			#P[
				版本判定指判斷某個組件的具體版本。
				證據按可靠度分三檔：
				行為差異、
				構建產物與資源指紋、
				以及組件自報的字串。
			]
			#P[
				只有第三檔證據時，
				得到的版本屬於推測。
			]
		]<版本判定>

		#T[源站][
			#P[
				源站指 @內容分發網絡 後面的那台真正處理請求的服務器。
				從外部解析到的位址通常是節點的位址，
				而不是源站的位址。
			]
			#P[
				源站往往沒有分發網絡那一層防護，
				但它是否在 @授權 範圍內要單獨確認。
			]
		]<源站>

		#T[資產歸屬][
			#P[
				資產歸屬指判斷一台機器或一個服務是否屬於目標單位。
				證據有四條：
				位址落在目標自己的網段、
				憑證主題指向目標、
				內容與目標業務相關、
				以及域名註冊資訊指向目標。
			]
			#P[
				來源相同的兩條只算一條，
				例如註冊人與備案主體同屬登記資料。
			]
		]<資產歸屬>

		#T[資產地圖][
			#P[
				資產地圖是測繪的兩份產出之一，
				把目標的域名、
				位址、
				端口、
				系統、
				以及維護者線索串成一張表。
			]
			#P[
				它要回答五個問題：
				這是甚麼、
				在哪、
				屬於誰、
				跑着甚麼、
				誰在維護。
			]
		]<資產地圖>

		#T[入口清單][
			#P[
				入口清單是測繪的另一份產出，
				逐條記錄從哪裏可以進入目標，
				以及每一條的弱點類型、
				利用前提、
				成功後可得、
				痕跡成本、
				歷史與可信度。
			]
			#P[
				它與 @資產地圖 的分工是：
				資產地圖記錄有甚麼，
				入口清單記錄能怎麼用。
			]
		]<入口清單>

		#T[情報可信度][
			#P[
				情報可信度指一條情報被相信的程度，
				分三級：
				已在授權範圍內驗證過的、
				有多個獨立來源互相印證的、
				以及單一來源或推測得到的。
			]
			#P[
				分級決定這條情報能用於哪一類動作，
				也決定一次失敗之後該懷疑情報還是懷疑手法。
			]
		]<情報可信度>
	]

// 專題篇《口令與憑據》的詞條。
// 與上面的 Terms 分開展開：
// 主篇只展開 Terms，該專題篇先展開 Terms 再展開本表，
// 這樣主篇的術語表不會多出它正文沒有引用過的條目。
// 排列順序是這些詞條在該篇正文裏第一次出現的順序。
#let CredentialsTerms = [
		#let T = MkTerm

		#T[帳號鎖定][
			#P[
				帳號鎖定指系統在一段時間內拒絕某個帳號的認證，
				即使口令是對的。
				觸發條件通常按同一帳號連續失敗的次數計算，
				配套的三個參數是閾值、
				鎖定持續時間、
				以及計數重置窗口。
			]
			#P[
				對 @紅隊 來說它是 @口令噴灑 這條路上最主要的限制，
				因為它把每個帳號的嘗試次數變成一個有限額度。
				兩個性質決定了預算怎麼花。
				一次成功的認證會把失敗計數清零；
				計數只在重置窗口內累加，
				所以兩次嘗試之間隔開一個窗口就不會累加。
			]
		]<帳號鎖定>

		#T[暴力破解][
			#P[
				暴力破解指在同一個帳號上反覆嘗試大量口令。
				它與 @口令噴灑 的方向相反：
				噴灑把嘗試次數攤在很多帳號上，
				暴力破解把嘗試次數集中在一個帳號上。
			]
			#P[
				它的直接後果是必然觸發 @帳號鎖定 ，
				而且會在認證日誌上留下同一帳號的密集失敗。
				它划算的場合只有兩種：
				目標沒有鎖定策略，
				或者手裏已經有口令的雜湊值，
				可以拿回本地離線嘗試而不產生任何網路流量。
			]
		]<暴力破解>

		#T[口令策略][
			#P[
				口令策略指一個系統對口令提出的要求，
				包括最短長度、
				必須包含的字元類別、
				最長使用期限、
				以及對歷史口令的限制。
				與它配套的是失敗處理規則，
				也就是 @帳號鎖定 。
			]
			#P[
				對 @紅隊 來說它要先反推出來，
				因為它決定了甚麼樣的口令有可能存在。
				反推的來源按可靠性排，
				是前端校驗的代碼、
				認證界面的報錯訊息、
				以及已控機器上的本地策略。
			]
		]<口令策略>

		#T[字典][
			#P[
				字典指一份用來猜口令的候選清單。
				它與別處洩漏來的帳號口令組合不同，
				因為它是紅隊按目標的資訊自己生成的。
				@口令噴灑 與 @暴力破解 都直接吃字典，
				所以字典的質量決定了這兩條路的命中率。
			]
			#P[
				按目標單位的公開資訊訂製的字典，
				效果遠好於通用字典。
				原因是通用字典裏最常見的那些口令，
				單位的 @口令策略 多半已經把它們排除在外；
				而由本單位人名與年份拼出來的口令，
				看上去既複雜又符合規則。
			]
		]<字典>

		#T[鍵盤路徑][
			#P[
				鍵盤路徑指按鍵盤上相鄰鍵的走向取出來的一串字元，
				例如同排相鄰的橫向序列、
				三個豎列的縱向序列、
				以及按住換檔之後的符號序列。
			]
			#P[
				它是一類獨立的口令來源，
				與人名地名無關，
				所以不會被「不含常見詞」這類規則攔住。
				它的長度通常在六到十二之間，
				生成時要把起點在鍵盤上平移幾個位置，
				因為每個人的習慣起點不同。
			]
		]<鍵盤路徑>

		#T[默認憑據][
			#P[
				默認憑據指出廠或安裝之後從來沒有被修改過的初始帳號與口令，
				也包括那些本來就沒有認證的管理界面。
				它與猜的區別是不需要猜，
				只需要知道對方用的是甚麼產品。
			]
			#P[
				查詢的順序是先靠 @指紋 認出產品，
				再去廠商文件、
				產品映像與公開的默認口令清單裏找對應的值。
				它在 @紅隊 的演習裏比在互聯網上更有用，
				因為內部設備很少被互聯網上的人碰過，
				廠商出廠的默認值可能已經用了很多年。
			]
		]<默認憑據>

		#T[一次性動態碼][
			#P[
				一次性動態碼指只在一次登入內有效的短數字碼，
				它是 @多因素認證 裏最常見的一種第二因素。
				按產生方式分兩類：
				一類由伺服器發到使用者的手機號碼上，
				另一類由使用者手上的程式按共用的種子算出。
			]
			#P[
				兩類的弱點不同。
				前一類的弱點在號碼可以被轉移或攔截；
				後一類的弱點在種子可以被釣魚頁面即時取走，
				因為使用者把它輸出來的那一刻，
				它就在對方手裏。
			]
		]<一次性動態碼>

		#T[硬體金鑰][
			#P[
				硬體金鑰指一個實體的認證裝置，
				它是 @多因素認證 裏目前公認最難繞的一種第二因素。
				難繞的原因在於它綁定的是來源：
				認證時把當前網站的名稱放進簽名裏，
				所以在一個不屬於真實網站的頁面上拿到的簽名，
				在真實網站上驗不過。
			]
			#P[
				它與 @一次性動態碼 的差別就在這裏。
				動態碼證明的是「手裏有東西」，
				硬體金鑰證明的是「在這個網站上手裏有東西」。
				後者把認證與被訪問的站點綁在了一起。
			]
		]<硬體金鑰>

		#T[中間人釣魚][
			#P[
				中間人釣魚指在受害者與真實網站之間放一個透明代理，
				讓受害者在真實網站上完成一次真實的認證，
				而攻擊者從中取得認證完成的結果。
			]
			#P[
				它繞過的不是第二個因素，
				而是第二個因素與後續訪問之間的綁定。
				前提有四條：
				使用者在不屬於真實網域的頁面上輸入憑證、
				代理能通過目標站點的反自動化檢查、
				目標發出的結果是可轉移的、
				以及這次認證的結果有足夠長的有效期。
			]
		]<中間人釣魚>

		#T[會話憑證][
			#P[
				會話憑證指使用者通過認證之後，
				網站發給瀏覽器用來代表這個身分的東西。
				它通常是一個工作階段識別碼，
				放在瀏覽器的儲存區裏，
				之後的每一次請求都帶上它。
				它本身就是一個已經通過認證的身分，
				所以在有效期內不再需要口令與第二因素。
			]
			#P[
				@中間人釣魚 要拿的就是它。
				圍繞它的兩個問題決定了風險大小：
				它與來源或裝置綁不綁定，
				以及它的有效期有多長。
			]
		]<會話憑證>

		#T[身分憑證][
			#P[
				身分憑證指由某個頒發機構簽發、
				用來證明主體身分的電子證書。
				驗證的一方不檢查口令，
				只檢查這張憑證上的簽名是不是來自它信任的頒發機構。
			]
			#P[
				所以只要簽發用的私鑰被別人拿到，
				就可以造出任意主體的身分憑證，
				整個口令與第二因素的環節都被跳過去。
				它不參與口令輪換，
				所以在口令這條路被切斷的環境裏是一個獨立的出口。
				它在域環境裏的展開屬於內網與域那一篇。
			]
		]<身分憑證>

		#T[記憶體轉儲][
			#P[
				記憶體轉儲指把某個程序佔用的記憶體整塊取出來，
				再從中解析出需要的內容。
				在憑據這一條路上，
				它針對的是負責認證的那個程序，
				因為互動式登入留下的口令材料、
				雜湊與票據都在那塊記憶體裏。
			]
			#P[
				它是 @憑據轉儲 裏收益最高的一步，
				需要在 @提權 之後才有權限做。
				它也是 @端點偵測與回應 最關注的一類行為，
				因為正常運維裏幾乎不會有程序去讀認證程序的記憶體。
			]
		]<記憶體轉儲>

		#T[口令雜湊][
			#P[
				口令雜湊指口令經過單向運算之後得到的值。
				系統保存它而不是保存口令本身，
				認證時把輸入的口令算一遍再比對。
				這個值也被叫做哈希，
				是同一個東西的兩種叫法。
			]
			#P[
				它的用途有兩個：
				可以用在那些以雜湊本身作為認證材料的協定上，
				也可以通過運算還原成明文。
				它的限制是不能用來改口令，
				而且在目標關掉了舊認證協定的環境裏完全失效。
			]
		]<口令雜湊>

		#T[快取憑據][
			#P[
				快取憑據指機器替 @域與域控 裏的帳號保存下來的登入材料，
				它存在的理由是讓使用者在 @內網 裏的認證伺服器不可達時仍能登入。
				它保存的數量有上限，
				預設是最近登入過的十個帳號。
			]
			#P[
				它與本機帳號的雜湊的差別在範圍。
				本機帳號的雜湊只對這一台機器有效，
				而快取憑據可以用來推導那個域帳號的口令，
				推出來之後範圍就是整個域。
				它的強度比本機雜湊高，
				所以它是本地取得憑據裏最值得花算力的一種。
			]
		]<快取憑據>

		#T[離線破解][
			#P[
				離線破解指把取到的 @口令雜湊 拿回自己的機器上運算，
				把口令還原成明文。
				它與在線猜的差別在於它不產生任何網路流量，
				所以不受 @帳號鎖定 與速率限制的約束。
			]
			#P[
				它的代價是需要算力，
				而且能不能還原取決於演算法的快慢與口令的熵。
				同一個弱口令在快演算法下幾秒就出來，
				而一個足夠長的口令在慢演算法下是算不出來的。
			]
		]<離線破解>

		#T[本機帳號][
			#P[
				本機帳號指只存在於某一台機器上的帳號，
				它不在域的目錄裏。
				它的範圍就是這一台機器，
				所以拿它的 @憑據 對 @橫向移動 沒有幫助。
			]
			#P[
				它的價值在於讀取這台機器上更多的東西，
				以及作為一個不起眼的落腳身分。
				判斷一個帳號是不是本機帳號，
				看它有沒有網域前綴、
				以及它在本機的帳號清單裏能不能找到。
			]
		]<本機帳號>

		#T[本機管理員][
			#P[
				本機管理員指某台機器上擁有管理權限的本機帳號。
				它的範圍是「所有共用同一組本機管理員口令的機器」，
				這一批有多大取決於部署方式。
				用統一映像部署、
				或者用 @組態管理工具 統一下發口令的環境裏，
				這一批可能覆蓋整片辦公網；
				而逐台手工裝出來的環境裏，
				每一台的口令都不一樣。
			]
			#P[
				判斷這一批有多大，
				最直接的方法是比較多台機器上同一個 @本機帳號 的雜湊是否相同。
				用它去登入一批機器在防守方眼裏動靜很大，
				所以合理的用法是只挑其中少數幾台關鍵的。
			]
		]<本機管理員>

		#T[域帳號][
			#P[
				域帳號指存在於域的 @目錄服務 裏、
				可以在域內使用的帳號。
				它的範圍是整個 @域與域控 管轄的範圍，
				具體能到哪一步取決於它屬於哪些群組。
			]
			#P[
				它是四級憑據範圍裏價值最高的一級，
				也是痕跡最重的一級：
				每一次用它做認證都會留下一條記錄，
				而這些記錄在多數單位裏是被集中收集的。
				它與 @服務帳號 的差別在使用方式而不在權限大小：
				服務帳號的動作發生在後台，
				域帳號的動作往往伴隨一次明確的登入。
			]
		]<域帳號>

		#T[認證日誌][
			#P[
				認證日誌指記錄「誰在甚麼時間從哪裏認證到哪裏」的那一類日誌，
				它與記錄程序行為的主機日誌是兩套東西。
				它的內容包括登入成功、
				登入失敗、
				取得票據、
				以及帳號被鎖這幾類事件。
			]
			#P[
				它與主機日誌的差別決定了偵測的難點。
				主機日誌的單條記錄可以單獨判斷；
				而認證日誌的單條記錄在一個每天有幾十萬條同類記錄的環境裏
				幾乎沒有資訊量，
				只有把它聚合成「帳號與來源的關係」、
				再與 @基線 比較才有意義。
				它也是 @痕跡清理 最難處理的一類記錄，
				因為它不在被入侵的那台機器上，
				而在認證伺服器與 @日誌集中 的平台裏。
				它與 @蜜罐 配合使用時訊號最乾淨。
			]
		]<認證日誌>
	]


// 專題篇《域與內網橫向》的詞條。
// 與上面的 Terms 分開展開：
// 主篇只展開 Terms，該專題篇先展開 Terms 再展開本表，
// 這樣主篇的術語表不會多出它正文沒有引用過的條目。
// 排列順序是這些詞條在該篇正文裏第一次出現的順序。
#let InternalAdTerms = [
		#let T = MkTerm

		#T[服務帳號][
			#P[
				服務帳號指為了讓某個服務或應用程式登入系統而建立的帳號。
				它與人工使用的帳號有三個差別：
				口令通常很長且很少更換，
				因為換了要同步改設定；
				它往往在許多台機器上有權限，
				因為服務要跨機器訪問資源；
				它的登入記錄看起來不像人，
				因為它只在服務啟動時登入。
			]
			#P[
				對 @紅隊 來說它是最有價值的一類 @憑據 。
				拿到一個服務帳號的口令或雜湊，
				常常等於拿到一批機器的訪問權，
				而且用它登入產生的日誌與正常服務啟動的時間一致，
				不容易被單條規則挑出來。
			]
		]<服務帳號>

		#T[網絡分區][
			#P[
				網絡分區指 @內網 按用途與策略寬鬆程度切成的若干段網絡。
				常見的四個分區是辦公網、
				生產網、
				管理網，
				以及放置對外服務的那一段。
			]
			#P[
				四個分區的分工不同。
				辦公網放員工終端，
				是 @紅隊 最容易進入的一段；
				生產網放承載業務的伺服器，
				是分數最集中的一段；
				管理網放運維與管理系統，
				包括 @域與域控 、
				堡壘機與 @組態管理工具 ；
				放置對外服務的那一段與 @內網 之間再隔一道策略。
			]
			#P[
				分區之間由防火牆與存取控制策略隔開。
				策略的寬鬆程度通常與業務的必要性成反比：
				辦公網到互聯網管得鬆，
				辦公網到生產網管得嚴，
				而管理網到其他各區留一條給運維的通道。
				紅隊在內網裏遇到的阻力，
				大部分就是這三道策略的寬鬆程度差異。
			]
		]<網絡分區>

		#T[虛擬化管理平臺][
			#P[
				虛擬化管理平臺指集中管理一批虛擬機的系統，
				它負責虛擬機的建立、
				遷移、
				快照與關機。
				常見的形態是廠商自帶的管理平臺，
				也有把多台主機組成資源池的集群版本。
			]
			#P[
				它的價值在它管着的那片虛擬機上。
				拿到管理平臺的管理權限，
				等於拿到那片虛擬機上所有系統的控制權：
				可以掛載映像、
				可以直接讀虛擬磁碟檔案，
				也可以把任意一台虛擬機重啟成自己控制的狀態。
				對 @紅隊 來說，
				這是繞過作業系統層防護的一條路。
			]
		]<虛擬化管理平臺>

		#T[備份系統][
			#P[
				備份系統指集中保存各系統歷史資料的系統，
				它按策略把生產系統的資料複製到備份介質上，
				並保留若干個歷史版本。
			]
			#P[
				它對 @紅隊 的價值有兩個。
				一是它保存着已經被刪除或已經被修補的資料，
				包括系統的舊組態與舊 @憑據 ；
				二是為了還原方便，
				它的存取權限通常配置得比生產系統更寬鬆，
				一台備份伺服器上常常能讀到幾十上百台機器的資料。
			]
		]<備份系統>

		#T[目錄服務][
			#P[
				目錄服務指把網路裏的使用者、
				群組、
				機器與權限規則集中存起來，
				並提供查詢與認證服務的系統。
				@域與域控 就是這類服務的一種實現，
				它的查詢協定叫輕量目錄訪問協定，
				英文縮寫是 LDAP。
			]
			#P[
				它有兩個對 @紅隊 重要的性質。
				一是所有物件都可以被查詢：
				只要手上有一個能通過認證的帳號，
				就能把全網的使用者、
				群組與機器列出來，
				不需要掃描。
				二是權限規則本身也存在裏面，
				所以「誰能對誰做甚麼」是一個可以直接讀出來的資料結構，
				這比在一台台機器上看本機權限省事得多。
			]
		]<目錄服務>

		#T[東西向流量][
			#P[
				東西向流量指 @內網 內部機器之間互相訪問的流量，
				包括伺服器到伺服器、
				應用程式到資料庫、
				以及運維工具到被管機器的流量。
				與之相對的是南北向流量，
				也就是客戶端穿過邊界訪問伺服器的流量。
			]
			#P[
				@內網 裏的東西向流量在設計上就很大，
				原因有三個。
				業務本身是分層的，
				一個請求往往要經過前端、
				應用、
				快取與資料庫四五台機器；
				內網的信任關係比互聯網鬆，
				機器之間預設放行的協定與端口比邊界上多；
				運維動作本身也在產生東西向流量，
				補丁分發、
				日誌上送、
				監控採集都是。
			]
			#P[
				流量大對 @紅隊 有兩重意義。
				一是隱蔽：
				在每天成千上萬條連線裏多加幾條，
				不顯眼。
				二是通道：
				內網的橫向手法之所以能用，
				正因為目標自己每天都在產生同樣的連線。
			]
		]<東西向流量>

		#T[出網控制][
			#P[
				出網控制指單位對 @內網 機器訪問互聯網所做的限制。
				常見做法是不給內網機器分配公網出口，
				所有出網流量必須經過代理，
				由代理按白名單放行位址、
				域名與協定。
			]
			#P[
				它對 @紅隊 的限制是直接的。
				@立足點 拿下來之後，
				被控機器連不上攻擊機，
				@命令與控制 通道發不出去，
				所以紅隊必須先解決出網這一環。
				解決這件事的技術統稱 @隧道與代理 。
			]
			#P[
				出網控制的鬆緊決定了通道的成本。
				只放行 Web 代理的網絡，
				通道要做成 HTTP 或 HTTPS 形態並能處理代理認證；
				允許直連某些業務位址的網絡，
				可以借用一台有出網權限的機器做跳板；
				完全不允許出網的網絡，
				紅隊只能靠人把資料帶出去。
			]
		]<出網控制>

		#T[機器帳號][
			#P[
				機器帳號指 @目錄服務 裏為每一台加入域的機器建立的帳號。
				它與 @服務帳號 一樣是帳號，
				但使用者是機器本身：
				機器用它向域證明自己的身份，
				並用它去拉取 @群組原則 、
				訪問被授權的資源。
			]
			#P[
				它的口令由系統自動輪換，
				週期以天計，
				所以紅隊很難長期保存一份可用的機器憑據。
				但機器帳號在目錄裏也有權限，
				例如修改自己的某些屬性，
				這一條屬於後文的權限關係濫用。
			]
		]<機器帳號>

		#T[遠端桌面][
			#P[
				遠端桌面指把一台機器的圖形界面投到另一台機器上操作的功能，
				微軟的實現叫 RDP。
				它是最直接的橫向通道：
				拿一組可用 @憑據 登入，
				就能以那個身份在目標機器上操作。
			]
			#P[
				它的前置條件比協議本身重要。
				目標要開啟遠端桌面服務，
				帳號要有登入目標的權限，
				而本機管理員預設就有這個權限。
				所以紅隊在這一步真正要解決的問題，
				是先拿到目標機器上管理員級別的憑據。
			]
		]<遠端桌面>

		#T[檔案共享][
			#P[
				檔案共享指機器之間通過網路讀寫對方目錄的功能，
				微軟的實現叫 SMB。
				它在橫向移動裏承擔兩件事：
				把要執行的內容送到目標機器上，
				以及讀取目標機器上本來就有的檔案。
			]
			#P[
				後者的價值往往更高。
				共享目錄的權限配置鬆弛是 @內網 的普遍現象，
				而讀取共享目錄不觸發任何執行類告警，
				只是多了一條檔案訪問記錄。
			]
		]<檔案共享>

		#T[群組原則][
			#P[
				群組原則指 @目錄服務 裏集中下發到一批機器的設定，
				英文縮寫是 GPO。
				它用來統一下發口令策略、
				軟體安裝、
				腳本執行、
				以及各類安全設定。
			]
			#P[
				它有兩個對 @紅隊 重要的地方。
				一是它本身是一條合法的橫向執行通道：
				原則在機器啟動或用戶登入時被拉取並執行；
				二是它本身可以被修改，
				所以拿到足夠權限之後，
				改一條原則就等於對一批機器下了一道命令。
			]
		]<群組原則>

		#T[遠端程序呼叫][
			#P[
				遠端程序呼叫指一個程式呼叫另一台機器上某個介面的機制，
				英文縮寫是 RPC。
				在 Windows 網路裏它是系統元件之間通信的基礎，
				許多管理動作本身就是一次遠端程序呼叫。
			]
			#P[
				@紅隊 用它有兩個好處。
				它在流量上與正常的管理呼叫混在一起；
				呼叫過程由系統元件完成，
				不需要紅隊自己帶程式進去。
				代價是它對呼叫方的權限與兩端的版本有一定要求。
			]
		]<遠端程序呼叫>

		#T[計劃任務與系統服務][
			#P[
				計劃任務與系統服務是作業系統提供的兩種自動執行機制。
				計劃任務按時間或事件觸發，
				系統服務在系統啟動時自動運行。
				兩者都能指定以哪一個帳號的身份運行。
			]
			#P[
				它們在橫向移動與 @權限維持 裏同時有用。
				橫向用它們：在遠端機器上登記一個任務，
				由系統自己去執行，
				紅隊不需要保持一條連線。
				維持也用它們：登記一次可以長期生效。
				代價是兩者都在系統的設定清單裏，
				而清單是防守方會定期核對的東西。
			]
		]<計劃任務與系統服務>

		#T[日誌集中][
			#P[
				日誌集中指把各類機器與設備產生的日誌送到同一個地方保存與分析，
				而不是留在各自的本機上。
				它在 @藍隊 那裏是橫向移動偵測的前提：
				一次橫向移動會在三台以上的機器上留下記錄，
				只看一台看不出全貌。
			]
			#P[
				要集中的日誌有四類：
				身分驗證相關的日誌，
				它記錄誰從哪裏登入；
				系統與服務的日誌，
				它記錄服務安裝與任務登記一類的變更；
				網路設備的日誌，
				它記錄跨區的連線；
				以及端點上的記錄，
				它記錄程式的啟動與命令列。
				另外還有一件常被忽略的事：
				集中之後要能存得夠久，
				否則事發當時的記錄早已經被覆蓋。
			]
		]<日誌集中>

		#T[域樹與域林][
			#P[
				域樹指共用同一個命名空間、
				由上而下分層的多個 @域與域控 組成的集合。
				父域的名字是子域名字的後綴，
				例如子域 a.example.com 的父域是 example.com。
			]
			#P[
				域林指多棵域樹通過 @信任關係 連成的整體。
				林是同一個域之外的另一層邊界：
				同一個林裏的所有域共用一套結構描述與組態，
				並且自動互相信任。
			]
			#P[
				對 @紅隊 來說，
				林決定了「拿到一個域之後還能不能往上走」。
				單個域的管理員只在本域有權限，
				而林根域的管理員組對整個林有效，
				兩者之間往往還差一步。
			]
		]<域樹與域林>

		#T[信任關係][
			#P[
				信任關係指兩個 @域與域控 之間建立的、
				允許一邊的使用者被另一邊認可的關係。
				有了信任關係，
				一個域的帳號才能訪問另一個域的資源。
			]
			#P[
				它有兩個維度。
				方向分單向與雙向：
				單向信任裏只有一邊認可另一邊的帳號，
				雙向信任裏兩邊互相認可。
				類型分可傳遞與不可傳遞：
				可傳遞的信任會把認可關係繼續傳給第三方，
				不可傳遞的信任只在一對域之間成立。
			]
			#P[
				@紅隊 要看的是三件事：
				本域與哪些域有信任關係、
				方向是哪一邊、
				以及本域的管理員身份在對面那個域裏有沒有權限。
				前兩件可以直接從域的組態裏讀出來，
				第三件要對照對面域的群組成員才能確定。
			]
		]<信任關係>

		#T[Kerberos][
			#P[
				Kerberos 是 @域與域控 環境使用的認證協定。
				它的核心思路是引入一個雙方都信任的第三方，
				由這個第三方簽發一段有期限的憑證，
				讓使用者與服務不必互相傳遞口令就能確認身份。
			]
			#P[
				為甚麼要這樣設計：
				在一個有成千上萬台機器的網路裏，
				若每個服務都自己保存一份使用者口令來做驗證，
				口令的副本會散落在每一台機器上，
				任何一台被拿下都會洩漏。
				Kerberos 把驗證集中到一個服務上，
				其餘的服務只驗證那一段簽發出來的憑證。
			]
			#P[
				它每一次通信都包含三樣東西：
				誰是使用者、
				想做甚麼、
				以及一段用金鑰加密的內容。
				後文把這個協定的三步認證過程按網路封包的形式寫一遍。
			]
		]<Kerberos>

		#T[主體名稱][
			#P[
				主體名稱指 @目錄服務 裏為某個服務註冊的名字，
				英文縮寫是 SPN。
				它的形式是服務類型加主機名，
				例如某台機器上的資料庫服務註冊成 MSSQLSvc/db01。
			]
			#P[
				註冊它的目的是讓客戶端能用名字找到對應的服務，
				並在認證時指明自己要訪問的是哪一個服務。
				因為 @金鑰分發中心 按這個名字簽發憑證，
				所以主體名稱本身是一份可查詢的服務清單，
				也是後文委派與口令猜測兩類手法的切入點。
			]
		]<主體名稱>

		#T[金鑰分發中心][
			#P[
				金鑰分發中心指 @Kerberos 裏負責簽發憑證的那個服務，
				英文縮寫是 KDC。
				在 @域與域控 環境裏它由域控擔任，
				所以域控同時是身分資訊的保管者與憑證的簽發者。
			]
			#P[
				它保存兩類金鑰。
				一類是每個帳號的金鑰，
				由帳號口令推導出來；
				另一類是它自己的長期金鑰，
				用來簽發它發出的每一段憑證。
				誰拿到那把長期金鑰，
				誰就能簽發任意身份的憑證，
				這是域控被拿下之後果最嚴重的原因。
			]
		]<金鑰分發中心>

		#T[票據授權票據][
			#P[
				票據授權票據是 @Kerberos 認證第一步的產物，
				英文縮寫是 TGT，
				也叫通行證票據。
				它由 @金鑰分發中心 簽發，
				證明這張票據的持有人已經通過了身份驗證。
			]
			#P[
				它與 @票據 的關係是總與分。
				使用者拿到它之後，
				再用它去換取訪問某一個具體服務的票據。
				@紅隊 拿到一張可用的票據授權票據，
				就等於拿到這個使用者在域內的身份，
				在這個使用者的權限範圍內可以做任何事，
				而不需要知道口令。
			]
		]<票據授權票據>

		#T[服務票據][
			#P[
				服務票據是 @Kerberos 認證第二步的產物，
				英文縮寫是 ST，
				也叫服務授予票據。
				它由 @金鑰分發中心 簽發，
				內容包括持有人是誰，
				以及一段用目標服務金鑰加密的資訊。
			]
			#P[
				它只對一個服務有效。
				訪問另一個服務要另換一張，
				但換的過程可以由系統自動完成，
				使用者無感。
				因為它用目標服務的金鑰加密，
				所以只有那台服務能讀出其中的內容，
				中間的機器即使截獲也讀不出來。
			]
		]<服務票據>

		#T[票據傳遞][
			#P[
				票據傳遞指不還原口令、
				直接把 @票據 拿到另一台機器上使用。
				@紅隊 在本機讀出票據之後，
				可以把它注入自己的會話，
				於是以票據所屬的身份訪問域內資源。
			]
			#P[
				它與拿口令登入的差別在痕跡上。
				用口令登入會在一次身分驗證裏留下記錄，
				而注入票據只是讓本機多了一段記憶體中的憑證，
				只要不去請求新的票據，
				就不一定產生新的認證事件。
				這也是為甚麼這種做法在應急處置時不容易被還原出來。
			]
		]<票據傳遞>

		#T[偽造票據][
			#P[
				偽造票據指 @紅隊 自己造出一張 @票據 ，
				而不是從目標那裏取得。
				造票據需要一段金鑰：
				造 @服務票據 需要目標服務的金鑰，
				造 @票據授權票據 需要 @金鑰分發中心 的長期金鑰。
			]
			#P[
				兩種偽造的後果不同。
				前者只能訪問一台機器上的那一個服務；
				後者可以在整個域裏冒充任何人，
				包括域管理員，
				而且因為偽造出來的票據與域自己簽發的形態一致，
				服務端無法區分它與真票據。
				這一條也解釋了為甚麼域控的長期金鑰一旦洩漏，
				單靠改口令無法補救。
			]
		]<偽造票據>

		#T[票據續期][
			#P[
				票據續期指在不重新輸入口令的前提下延長票據的使用期限。
				@票據授權票據 有兩個時間：
				一個是單次使用期限，
				到點之後必須換新的；
				另一個是整體最長期限，
				超過之後無論怎麼續都要重新認證。
			]
			#P[
				續期的做法是拿手上的票據再換一張新的票據授權票據。
				系統在後台自動完成這件事，
				條件是原票據還在最長期限之內。
				對 @紅隊 來說，
				這決定了偷來的票據能用多久，
				也決定了為甚麼要在拿到票據之後盡快把權限固定下來。
			]
		]<票據續期>

		#T[安全識別符][
			#P[
				安全識別符是 @目錄服務 給每一個使用者、
				群組與機器分配的編號，
				英文縮寫是 SID。
				它與名字無關：
				同一個帳號改了名字，
				SID 不變，
				所以權限判斷一律按 SID 走，
				不按名字走。
			]
			#P[
				這一點在 @紅隊 那裏有兩個用途。
				一是判斷兩個帳號是不是同一個身份：
				名字可以重複，
				SID 不會；
				二是理解權限繼承：
				一個群組被授予的權限，
				是通過群組的 SID 寫進 @存取控制清單 的。
			]
		]<安全識別符>

		#T[權限關係濫用][
			#P[
				權限關係濫用指不利用漏洞、
				只利用 @目錄服務 裏配置得過寬的授權關係來取得更多權限。
			]
			#P[
				可用的關係有四類。
				一類是 @存取控制清單 上的細粒度授權，
				例如某個帳號被授予了對另一個帳號重設口令的權限；
				一類是群組嵌套，
				一個看起來普通的群組可能是高權限群組的成員；
				一類是 @委派 與 @憑證服務 的設定；
				一類是 @機器帳號 與 @服務帳號 被授予的權限。
			]
			#P[
				這類手法的特點是每一步都合法，
				所以流量與日誌上沒有可直接匹配的異常特徵，
				防守方能依靠的只有權限變更本身的記錄。
			]
		]<權限關係濫用>

		#T[存取控制清單][
			#P[
				存取控制清單是掛在 @目錄服務 物件上的一張權限表，
				英文縮寫是 ACL。
				表裏每一行叫一個存取控制項目，
				寫着「哪一個 @安全識別符 對這個物件能做甚麼」。
			]
			#P[
				它能表達的權限比讀與寫細得多，
				例如重設口令、
				修改群組成員、
				複製目錄變更、
				以及對某個物件的單一屬性單獨授權。
				這些細粒度授權是 @權限關係濫用 那一類手法的基礎。
			]
		]<存取控制清單>

		#T[委派][
			#P[
				委派指把以使用者身份訪問另一個服務的權限交給一個服務，
				讓它在替使用者辦事的過程中能繼續以使用者的名義訪問下游資源。
			]
			#P[
				它常見於三層結構的業務系統。
				使用者訪問前端的網站，
				網站再去訪問後端的資料庫；
				若資料庫按使用者身份做權限判斷，
				網站就必須拿到使用者的身份才能查。
			]
			#P[
				它按限制程度分三類。
				無限制委派允許被委派的服務冒充使用者訪問任何服務；
				受限委派把可冒充的目標限定在一份清單裏；
				資源型受限委派把授權決定放在資源那一側，
				由資源自己聲明允許哪些服務冒充使用者來訪問。
				三類的可利用性差別很大，
				判斷方法寫在正文裏。
			]
		]<委派>

		#T[憑證服務][
			#P[
				憑證服務指 @域與域控 環境裏簽發與管理數位憑證的元件，
				英文縮寫是 AD CS。
				它把憑證發給使用者、
				機器與服務，
				用來做登入、
				加密與簽名。
			]
			#P[
				它的地位與 @金鑰分發中心 平行：
				兩者都能證明身份，
				差別在憑證是長期有效的，
				而且簽發之後由持有人自己保存。
				對 @紅隊 來說，
				它的價值有兩處：
				憑證本身可以換成身份；
				它的範本設定裏常常藏着可以讓非管理員申請高權限憑證的配置。
			]
		]<憑證服務>

		#T[基線][
			#P[
				基線指防守方事先記錄下來的正常狀態，
				包括哪些帳號在哪些時間從哪些機器登入、
				哪些程式在哪些機器上運行、
				以及各類服務每天產生多少流量。
			]
			#P[
				它的作用是提供比較的對象。
				在單條日誌上，
				一次異常橫向登入與一次正常運維登入幾乎沒有差別；
				能把它們分開的只有這次行為與基線的偏離程度。
				所以沒有基線的單位，
				即使把日誌都收齊了，
				也很難在演習期間做出判斷。
			]
		]<基線>
	]

// 專題篇《對外服務與邊界設備的漏洞利用》的詞條。
// 與上面的 Terms 分開展開：
// 主篇只展開 Terms，該專題篇先展開 Terms 再展開本表，
// 這樣主篇的術語表不會多出它正文沒有引用過的條目。
// 排列順序是這些詞條在該篇正文裏第一次出現的順序。
#let WebExploitTerms = [
		#let T = MkTerm

		#T[危險位置][
			#P[
				危險位置指程式裏一個會把輸入當成指令或者程式碼解釋的位置。
				常見的形態有查詢字串的拼接處、
				作業系統命令的呼叫點、
				模板的求值點、
				以及物件還原的入口。
			]
			#P[
				它與輸入點是一對概念。
				輸入點決定 @紅隊 能送甚麼進去，
				危險位置決定送進去的東西會被當成甚麼。
				兩者之間的距離、
				以及中間有沒有過濾，
				決定了利用的難度。
			]
		]<危險位置>

		#T[回顯][
			#P[
				回顯指漏洞利用的結果直接出現在回應裏。
				有回顯時，
				紅隊能看到自己提問的答案；
				沒有回顯時，
				只能通過回應的差異、
				回應的時間、
				或者目標發出的對外連線去推斷。
			]
			#P[
				後一種情形統稱盲利用。
				有無回顯決定的是利用成本的量級，
				而不是漏洞本身的嚴重程度，
				所以它是紅隊排期時先要判斷的一件事。
			]
		]<回顯>

		#T[帶外通道][
			#P[
				帶外通道指不依賴正常回應、
				而借助另一條通路把結果送出來的方式。
				常見的形態是讓目標對外發起一次域名查詢或者一次連線，
				由紅隊自己控制的服務端接收。
			]
			#P[
				它的前提是目標能出網。
				在沒有 @回顯 的漏洞上，
				它常常是唯一可行的確認手段，
				所以目標的出網策略會直接決定這一類漏洞能不能驗證。
			]
		]<帶外通道>

		#T[物件儲存][
			#P[
				物件儲存指以桶為單位、
				通過網頁介面存放與讀取檔案的服務。
				它與檔案系統的差別在於沒有目錄權限的概念，
				存取由桶與物件各自的授權設定決定。
			]
			#P[
				設定失誤時桶可以被公開讀取甚至公開寫入。
				這是配置錯誤一類裏最常見的一種，
				也是文件上傳那一類的一種反面情形：
				上傳的檔案根本不在伺服器的檔案系統上。
			]
		]<物件儲存>

		#T[網頁殼][
			#P[
				網頁殼指放在伺服器上、
				通過網頁請求控制的一類腳本。
				它的功能從執行單條命令到完整的檔案管理都有。
			]
			#P[
				它的價值是提供一個可以反覆回來的位置，
				代價是它的檔案特徵明顯，
				而且長期存在，
				容易被基於檔案的檢查或者人工巡檢發現。
			]
		]<網頁殼>

		#T[二次渲染][
			#P[
				二次渲染指伺服器在收到圖片之後重新編碼一次再保存。
				它會丟掉附加在圖片尾部或者中繼資料裏的內容，
				因此是文件上傳這一類裏最徹底的一種防護。
			]
			#P[
				判斷的方法是把自己上傳的檔案下載回來，
				與原始位元組比對，
				看附加的部分還在不在。
			]
		]<二次渲染>

		#T[檔案完整性監控][
			#P[
				檔案完整性監控指對關鍵目錄的檔案建立基線，
				並對新增、
				修改與刪除告警的機制。
				它是發現 @立足點 最直接的手段之一，
				因為持久化必然要動檔案。
			]
			#P[
				它有一個常見的缺口：
				只對新增告警而不對修改告警，
				而修改一個既有的業務檔案恰好是最安靜的持久化方式。
			]
		]<檔案完整性監控>

		#T[注入][
			#P[
				注入指程式把使用者能控制的資料與一段指令拼在同一個字串裏，
				使資料被當成指令的一部分解釋。
				按被拼進去的位置分，
				常見的有資料庫查詢、
				作業系統命令、
				模板與表達式四種。
			]
			#P[
				四者的共同前提是同一個，
				可利用的深度差別很大：
				愈靠近宿主語言的執行能力，
				一次成功換到的東西愈多。
			]
		]<注入>

		#T[資料庫注入][
			#P[
				資料庫注入指輸入被拼進資料庫查詢語句的結構裏。
				它的判斷重點是有沒有回顯、
				能不能改變查詢結構、
				以及資料庫是哪一種。
			]
			#P[
				若能改變結構，
				紅隊就可以在語句層面提問；
				而資料庫自身若有寫檔或者執行命令的能力，
				這一類可以直接變成命令執行，
				不必再找別的路。
			]
		]<資料庫注入>

		#T[命令注入][
			#P[
				命令注入指輸入流進一個會執行外部程式的位置，
				並且經過一個會解析分隔符的殼層。
				不經過殼層時，
				分隔符只是普通的參數內容，
				整類不成立。
			]
			#P[
				它的觸發條件窄，
				但一旦成立就是命令執行，
				不需要第二段利用。
				它的痕跡也比別的注入重，
				因為它真的會啟動一個行程。
			]
		]<命令注入>

		#T[模板注入][
			#P[
				模板注入指輸入進入了模板的求值過程，
				而不是被當成模板的資料傳入。
				它與前端模板的區別在於求值發生在伺服器那一側。
			]
			#P[
				它的可利用深度通常大於其他注入，
				因為模板語言為了方便，
				一般能訪問宿主語言的物件；
				可利用性則取決於引擎、
				版本與有沒有開啟沙箱。
			]
		]<模板注入>

		#T[表達式注入][
			#P[
				表達式注入指輸入被框架當成運算式求值，
				常見於參數綁定、
				排序欄位、
				動態查詢與規則運算。
			]
			#P[
				它與 @模板注入 的判斷方式接近，
				差別在觸發的位置與宿主框架；
				可利用的深度取決於那個運算式語言能碰到甚麼。
			]
		]<表達式注入>

		#T[序列化鏈][
			#P[
				序列化鏈指一串在還原過程中會被依序呼叫、
				最終產生實際副作用的類別組合。
				它成立需要三個條件：
				還原時允許由資料指定型別、
				行程的類別路徑裏存在有副作用的類別、
				以及那些副作用能串到命令執行或者檔案操作。
			]
			#P[
				它因此取決於目標載入了哪些程式庫，
				而不取決於目標自己寫了甚麼。
			]
		]<序列化鏈>

		#T[反序列化過濾器][
			#P[
				反序列化過濾器指執行環境提供的、
				用來限制可以被還原的型別的白名單或者黑名單機制。
			]
			#P[
				它把 @反序列化 這一類的判斷重點從有沒有可用的 @序列化鏈
				改成有沒有過濾。
				它被繞過的難度取決於規則是由應用以外的力量強制執行，
				還是由應用自己設定。
			]
		]<反序列化過濾器>

		#T[物件標識][
			#P[
				物件標識指請求裏用來指向某一個業務物件的那個值，
				例如訂單號、
				使用者編號或者檔案名。
				@越權訪問 的水平形態就是換掉這個值。
			]
			#P[
				判斷它的可利用性看三點：
				能不能枚舉、
				有沒有簽名或者與工作階段綁定、
				以及換掉之後回應裏的內容是不是真的換了對象。
			]
		]<物件標識>

		#T[雲端中繼資料][
			#P[
				雲端中繼資料指雲上執行個體可以從一個固定的本機位址讀到的自身資訊，
				內容包括執行個體的身分憑據、
				組態與標籤。
			]
			#P[
				它不對外開放，
				但任何能從該執行個體發起請求的人都能讀到，
				因此它是 @服務端請求偽造 這一類裏價值最高的一個目標。
			]
		]<雲端中繼資料>

		#T[密碼重設流程][
			#P[
				密碼重設流程指使用者在忘記口令時重新設定口令的流程，
				通常由三個要素組成：
				識別身分、
				證明身分、
				以及提交新口令。
			]
			#P[
				它的常見缺陷不在單個環節，
				而在三個要素之間的耦合，
				尤其是證明與識別沒有綁定在同一個工作階段上。
			]
		]<密碼重設流程>

		#T[驗證碼][
			#P[
				驗證碼指用來區分人與自動化程式的挑戰，
				通常是一段需要辨識的圖形或者一次簡訊。
			]
			#P[
				判斷它是不是障礙，
				要看校驗發生在哪一端、
				字串有沒有回顯、
				有沒有與工作階段綁定、
				有沒有一次性，
				以及有沒有次數限制。
			]
		]<驗證碼>

		#T[業務邏輯缺陷][
			#P[
				業務邏輯缺陷指程式的實作與它的業務規則不一致，
				使攻擊者可以按規則之外的方式完成流程。
			]
			#P[
				它與技術缺陷的區別在於它不依賴任何程式錯誤，
				只依賴某一步的前提沒有人保證。
				它的判斷方法就是把流程拆成步驟，
				對每一步問前提由誰保證。
			]
		]<業務邏輯缺陷>

		#T[無檔案落地][
			#P[
				無檔案落地指讓執行的內容只存在於記憶體或者既有行程裏，
				不在磁碟上留下檔案。
			]
			#P[
				它躲開了所有基於檔案的檢查，
				代價是它在行為層留下的痕跡更重，
				而且隨着宿主行程的結束而消失。
			]
		]<無檔案落地>

		#T[負載均衡][
			#P[
				負載均衡指把請求分發到多個後端實例的機制。
			]
			#P[
				它對 @紅隊 的意義在於：
				通過某一個實例放上去的檔案只存在於那一個實例上，
				後續請求可能被分到別的實例。
				判斷它是多實例的方法包括看回應的一致性、
				看回應裏的標識是不是指向不同的後端、
				以及看有沒有工作階段黏滯。
			]
		]<負載均衡>

		#T[資產盤點][
			#P[
				資產盤點指把一個單位實際擁有的資產列全並持續維護的過程。
				它與 @攻擊面 測繪的區別在於立場：
				盤點是防守方的自我清點，
				測繪是外部對暴露面的推斷。
			]
			#P[
				配置錯誤與 @影子資產 這兩類問題都建立在它之上，
				所以它也是防守方收益最高的一件事之一。
			]
		]<資產盤點>

		#T[虛擬補丁][
			#P[
				虛擬補丁指在不修改目標程式的前提下，
				用外層的防護設備攔住針對某個漏洞的利用。
				它的作用是為真正的補丁爭取部署時間。
			]
			#P[
				它與真補丁的差別是它只擋住已知的利用形態，
				改變形態的利用仍然可以通過。
			]
		]<虛擬補丁>
	]
