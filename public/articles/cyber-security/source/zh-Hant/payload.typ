#import "../../_Common.typ": *
#show: _Show
#import "terms.typ": *

// 概念鏈規約的兩個擴展點，由文檔所有者定義。本檔只用到 MkTerm（在 terms.typ 裏）。
#let R(cont) = { cont }

#_Document("payload", title: [武器與載荷：從哪來、怎麼驗、用完怎麼收])[
	#title[武器與載荷：從哪來、怎麼驗、用完怎麼收]

	#P[
		這一篇是 @護網演習 紅隊那條主線的延伸，
		補的是主篇一直沒有展開的一塊：
		打進目標機器之後跑起來的那些東西，
		是甚麼、
		從哪來、
		怎麼判斷能不能用、
		用完之後怎麼收。
	]
	#P[
		主篇把這件事壓在「站穩」那一章的一節裏，
		寫到「樣本繞過終端防護的三個方向」就停了。
		那一節回答的是往哪個方向想，
		這一篇回答的是東西從哪來、
		拿甚麼標準挑、
		怎麼驗、
		出事之後怎麼處置。
	]
	#P[
		先把本篇不寫甚麼說清楚。
		下面只寫到機制、
		判斷標準與工程流程，
		不寫某一個具體載荷的製作步驟，
		也不寫能照着抄的完整利用鏈。
		理由有兩條。
		一是這些內容兩年就過時，
		寫進來的當天就開始變舊；
		二是它們的正當性完全來自 @授權 ，
		離開那份授權就是刑事案件的材料，
		這一點主篇寫在最前面，
		本篇不再重複。
	]
	#P[
		本篇的讀者與主篇相同，
		是有運維或開發基礎、
		做過攻防的從業者。
		文中凡引用外部資料一律掛腳註。
	]

	#H[先把三樣東西分開][
		#P[
			日常說做一個 @載荷 ，
			其實把它裏面的三樣東西混在了一起。
			它們的來源、
			更新節奏與風險都不一樣，
			分開之後很多問題才有答案。
		]
		#P[
			第一樣是 @誘餌 。
			它是給人看的那一層：
			一封郵件、
			一個 Office 文檔、
			一個壓縮包、
			一張仿冒的登入頁。
			誘餌的成敗取決於它說的事情在對方的工作裏合不合理，
			與技術關係不大。
			主篇講釣魚那一節講的就是這一層。
		]
		#P[
			第二樣是 @加載器 。
			它是被誘餌帶進去、
			第一個跑起來的東西。
			它的任務只有一件：
			把真正幹活的東西弄起來，
			然後把自己從視野裏抹掉。
		]
		#P[
			第三樣是 @被控端 。
			它是長期留在目標機器上、
			聽 @命令與控制 指揮的那一段。
			後續的提權、
			取 @憑據 、
			@橫向移動 都從它開始。
		]
		#P[
			三樣東西的壽命不一樣，
			這件事直接決定紅隊怎麼分配時間。
			誘餌投遞一次就廢掉，
			同一封郵件不可能投兩次；
			加載器通常在幾小時內就被端點防護記住，
			同一版用不了幾次；
			被控端要活到演習結束，
			可能要用兩三週。
			所以三者的投入比例通常是反的：
			誘餌最省，
			加載器要能快速換，
			被控端要最穩。
		]
		#P[
			還有一件事要在開頭講明白。
			三樣東西的痕跡落在三個不同的地方。
			誘餌的痕跡在郵件服務器和員工的收件箱裏；
			加載器的痕跡在終端上，
			而且是最容易被記下來的那一段；
			被控端的痕跡在網路上，
			因為它要定期回連。
			紅隊在排查「為甚麼這條路失敗了」的時候，
			第一步就是先定位失敗在哪一樣東西上。
		]
	]

	#H[東西從哪來][
		#P[
			先說結論：
			紅隊手上的東西有四條來源，
			其中一條在演習裏不能用。
			四條的差別不在於哪條更強，
			而在於事前要投入多少、
			事後能不能追溯。
		]
		#P[
			第一條是開源 @命令與控制 框架自帶的生成器。
			主流的幾套框架都能直接生成被控端和各類載荷格式，
			參數填好就出一個檔案。
			這是多數紅隊實際用的東西，
			優點是快、
			協定實現成熟、
			團隊成員都熟悉；
			缺點也很直接：
			它的特徵是公開的，
			防守方的簽名庫與偵測規則裏早就有它。
			用開源生成物等於接受一個前提，
			就是「對方認得出來，只是不知道你會不會來」。
		]
		#P[
			第二條是自己寫。
			講究的隊伍自寫的部分通常不是全部，
			而是三塊：
			加載器、
			流量配置、
			以及換宿主的方式。
			這三塊是防守方規則最容易命中的地方，
			也是最值得投入的地方。
			反過來說，
			加密演算法、
			協定框架、
			指令調度這些東西自己重寫，
			除了浪費時間沒有別的收益。
			分界線可以概括成一句：
			凡是防守方能寫成規則的部分，
			值得自己寫；
			凡是已經有成熟公開實現、
			而且寫死了也不會更隱蔽的部分，
			直接用現成的。
		]
		#P[
			第三條是拿公開的漏洞利用代碼改成誘餌。
			這條路在釣魚裏很常見：
			一封郵件帶一個用已知漏洞做成的文檔，
			使用者只要打開就觸發。
			它的價值取決於目標有沒有打補丁，
			也就是主篇講 @1day與Nday 那一節的判斷。
			用這條路要注意一件事：
			公開的利用代碼品質差別極大，
			有的是完整的，
			有的只是能證明漏洞存在。
			拿一個「能證明存在」的東西當誘餌，
			失敗率很高，
			而失敗的投遞會消耗掉發信域的信譽。
		]
		#P[
			第四條是商業或地下的樣本與工具包。
			這一條在演習裏不能用，
			理由有四條，
			每一條單獨都夠。
			一是它本身就是違法物品，
			持有與使用都成問題；
			二是來路不明的樣本常常夾帶了原作者的東西，
			等於把一個不受自己控制的程序放進了目標網路；
			三是它一旦在目標環境裏暴露，
			紅隊無法解釋它的來源，
			這件事在裁判那裏是無法收場的；
			四是它沒有任何可追溯的版本紀錄，
			演習結束之後無法證明自己銷毀乾淨了。
			主篇講 @演習規則 時說紅線的共同點是後果不可逆，
			這一條屬於同一類。
		]
		#P[
			四條來源之外，
			還有一件工程上的事要在開打前定下來：
			版本管理。
			同一批載荷要能回答三個問題：
			這一版是甚麼時候做的、
			用在了哪幾個目標上、
			演習結束之後要銷毀哪幾份。
			這三個問題答不上來的時候，
			紅隊會同時失去兩樣東西：
			事後復盤的材料，
			以及證明自己已經清理乾淨的能力。
			做法不必複雜，
			一份帶時間戳的清單就夠，
			但要從第一次投遞開始記，
			不能事後補。
		]
	]

	#H[一個載荷要過的六道關][
		#P[
			一個載荷從離開紅隊到在目標上活下來，
			要連續過六道關。
			這六道關的關鍵性質是它們互相獨立：
			前一關過了，
			不表示後一關有機會過；
			而且每一關失敗的表現不一樣，
			混在一起看就會得出錯誤的結論。
		]
		#P[
			第一關是落地。
			也就是那個檔案或那個鏈接能不能進到目標的使用者手裏。
			這一關的對手是郵件閘道與瀏覽器，
			判斷的依據是寄件人信譽、
			檔案類型、
			連結指向的域齡、
			以及郵件的結構特徵。
			這一關的失敗表現是郵件根本沒到，
			或者到了但在隔離區裏。
			主篇講釣魚投遞那一節講的就是它。
		]
		#P[
			第二關是放行。
			檔案到了使用者手上，
			作業系統還要決定讓不讓它跑。
			這一關要處理的是三個機制：
			從網路下來的檔案帶的那個來源標記，
			它會讓系統用更嚴的規則對待這個檔案；
			受保護檢視與各類警告，
			它們把執行動作多分成一步，
			讓使用者有機會放棄；
			以及副檔名的關聯，
			也就是雙擊之後到底是哪個程式被叫起來。
			這一關的失敗表現是使用者放棄，
			或者檔案被系統原地攔下。
			紅隊判斷能不能過這一關的依據，
			是目標終端的策略與 Office 一類產品的設定，
			不是載荷本身寫得好不好。
		]
		#P[
			第三關是起得來。
			程式被叫起來之後，
			第一件事是判斷自己在甚麼地方。
			這一關的對手是目標可能部署的 @沙箱 與自動分析環境，
			也是紅隊自己寫的環境檢查。
			這一關的失敗有兩種完全相反的樣子。
			檢查太鬆，
			載荷在分析環境裏跑起來了，
			行為被記下來，
			這一版就廢了；
			檢查太嚴，
			載荷在真實目標上也判定環境不對，
			自己退出了，
			紅隊看到的是「沒有回連」，
			很容易誤判成「被防護攔截」，
			於是去改載荷的行為，
			改了還是回不來，
			時間就耗在這裏。
			把這兩種失敗分開，
			是這一關最重要的功課。
		]
		#P[
			第四關是活得下去。
			這一關的對手是 @端點偵測與回應 一類的行為型防護，
			它看的是三個層次：
			檔案本身長甚麼樣、
			程式做了甚麼動作、
			記憶體裏出現過甚麼。
			主篇已經把繞過的三個方向寫清楚了，
			這裡只補一句判斷標準：
			三個層次不是三選一，
			而是三段接力，
			一段被識破，
			後面兩段都要重來。
			這一關的失敗表現是載荷執行成功但通道很快斷掉，
			或者執行之後機器重啟，
			東西就沒了。
		]
		#P[
			第五關是出得去。
			被控端要回連，
			而目標可能不讓它出去。
			這一關的對手是出網策略、
			代理、
			以及 DNS 的解析控制。
			判斷依據是目標允許哪些協定與端口出網、
			出網流量有沒有被解密與還原、
			以及有沒有對出網建立過基線。
			主篇講通道挑選的三個問題就是這一關。
			這一關的失敗表現最容易被誤讀：
			載荷跑起來了，
			但控制端沒有任何反應，
			紅隊會以為是載荷有問題，
			實際上是流量沒出去。
		]
		#P[
			第六關是留得住。
			前面五關都過了，
			還要面對目標的重啟、
			例行清理與 @藍隊 的處置。
			這一關的判斷依據是這台機器對防守方有多重要、
			以及紅隊還需要它多久。
			主篇講 @權限維持 那一節列了四類落腳點與各自的存活期，
			本篇不再重複。
		]
		#P[
			把六道關連起來看，
			會得到一個對排期有用的結論：
			一個載荷失敗的時候，
			紅隊要先判斷它卡在哪一關，
			再決定改甚麼。
			六關裏只有第四關與第五關可以靠改載荷解決，
			前兩關要改誘餌，
			第三關要改環境檢查，
			第六關要改落腳方式。
			不看關口直接改載荷，
			是這一塊最常見的時間浪費。
		]
	]

	#H[加載器到底在做甚麼][
		#P[
			加載器做的事情可以壓成三件：
			判斷自己在哪、
			把真正的東西還原出來、
			換一個身分去跑它。
			三件的順序通常不會變，
			但每一件的做法差別很大，
			差別決定了它的痕跡落在哪一層。
		]
		#P[
			判斷自己在哪，
			看的是環境裏那些「自動分析環境很難偽裝得像」的東西。
			常見的判斷依據有幾類：
			硬體屬於甚麼型號、
			記憶體與處理器數量、
			磁碟容量與型號；
			系統的語言與時區；
			機器名與所屬的網域；
			開機時間的長短；
			使用者目錄裏有沒有日常使用的痕跡，
			例如文件、
			瀏覽器歷史、
			最近開啟的項目；
			以及滑鼠與鍵盤有沒有真實的移動。
			這幾類的共同點是不依賴防護產品，
			只依賴目標是不是一台真人在用的機器。
		]
		#P[
			這裡有一個反覆出現的權衡。
			判斷依據越多，
			在分析環境裏越不容易被認出來；
			但判斷依據越多，
			在真實目標上誤判的機率也越高。
			真實環境裏會出現各種不合常理的機器：
			剛重裝的辦公電腦、
			遠端辦公從不接滑鼠的伺服器、
			跑在虛擬化平臺上的正式業務系統。
			所以環境檢查的設計目標不是「認出分析環境」，
			而是「在真實環境裏不要誤傷自己」，
			這兩個目標的方向其實是相反的。
		]
		#P[
			把真正的東西還原出來，
			通常處理的是加密與分段。
			這一件事本身沒有太多可講的，
			要點只有兩個。
			一個是金鑰從哪來，
			金鑰跟著載荷一起送到目標上等於沒加密；
			另一個是還原之後放在哪，
			放在磁碟上就多了一次落地的痕跡，
			放在記憶體裏就更依賴宿主。
			這兩個要點決定的是痕跡，不是強度。
		]
		#P[
			換一個身分去跑它，
			就是主篇寫過的 @進程注入 與 @白利用 。
			兩條路的取捨可以說得更具體一些。
			借一個已經在運行的進程，
			好處是程式碼不出現在磁碟上，
			壞處是跨進程的記憶體操作恰好是 @端點偵測與回應 最敏感的幾類事件之一。
			借系統自帶的工具，
			好處是那個工具本身在白名單裏，
			壞處是它會留下正常的程序樹與命令列參數，
			而這兩樣都是有紀錄的。
			所以選擇的依據不是哪一種更先進，
			而是目標的防護更看重哪一類事件。
		]
		#P[
			加載器還有一件事容易被忽略：
			它自己怎麼結束。
			一個跑完之後留在記憶體裏、
			既不回連也不退出的加載器，
			在端點防護那裏是一個沒有任何正常用途的常駐程序，
			比它幹了甚麼更容易被注意到。
			所以「幹完就消失」不是美觀問題，
			而是這一層的基本要求。
			反過來，
			如果加載之後要靠它維持通道，
			那它就不是加載器，
			而是被控端的一部分，
			兩者要分清楚。
		]
	]

	#H[被控端到底在做甚麼][
		#P[
			被控端做的事情有五件：
			回連、
			取指令、
			執行、
			回報、
			自我保護。
			五件事裏前三件是功能，
			後兩件決定它能活多久。
		]
		#P[
			回連要處理的核心問題是節律。
			被控端不可能只連一次，
			也不可能一直連著，
			所以它必須按某個間隔主動回連。
			固定間隔在流量統計上是一個明顯的節律，
			防守方建立一段基線之後很容易把它挑出來，
			這就是 @心跳與抖動 要解決的事。
			這裡要補的是判斷標準：
			心跳間隔的取值取決於兩件事，
			目標有沒有對出網建立基線，
			以及紅隊能接受多大的指令延遲。
			目標的基線越細，
			間隔就要越不規律、
			整體越長；
			紅隊越急，
			間隔就要越短。
			兩邊都不能極端，
			間隔長到幾個小時，
			處置發生時紅隊會來不及反應；
			間隔短到幾十秒，
			任何一次流量普查都會把它挑出來。
		]
		#P[
			取指令與執行這一頭，
			有一個設計上的分岔要講清楚：
			指令是整段下發還是拆成小步。
			整段下發的優點是行為集中、
			一次連線就完成，
			缺點是每一次連線的行為特徵都很明顯，
			而且被截獲一次就暴露完整意圖；
			拆成小步的優點是每一次連線都很短、
			看起來像正常的零星請求，
			缺點是指令的組合關係會在日誌上留下可關聯的痕跡，
			而且整體暴露的時間更長。
			這個分岔沒有通用答案，
			判斷依據是目標的日誌保留期與關聯分析能力。
			日誌只留七天而且不做關聯的單位，
			拆步幾乎沒有額外收益；
			日誌留一年而且有集中分析平臺的單位，
			整段下發等於自投羅網。
		]
		#P[
			回報要與外傳分開。
			回報是把執行結果送回控制端，
			資料量小、
			是通道的日常功能；
			外傳是把目標機器上的業務資料取走，
			資料量大、
			而且通常直接觸犯 @演習規則 。
			演習裏紅隊需要的是「能證明我拿到了」，
			不是「真的把資料搬走」。
			兩者在技術上可以用同一條通道，
			但在規則上是兩件事，
			紅隊在設計被控端的時候就要把這兩件事分開，
			否則很容易在一次順手的操作裏越線。
		]
		#P[
			自我保護要做三件事：
			通道被斷之後還能回來、
			被清理之後知道、
			以及被發現之後不至於一次全丟。
			第一件靠多通道，
			這裡要注意一個常見的錯誤：
			多條通道如果共用同一個域名或同一組位址，
			防守方處置一次就全斷，
			那不叫多通道，
			只是同一條通道換了個外殼。
			第二件靠一個獨立的、
			不通過主通道的通知方式，
			它的唯一用途是告訴紅隊「主通道沒了」。
			第三件靠把憑據與環境資訊在拿到手的時候就取走，
			而不是等需要的時候再回去取，
			因為需要的時候那台機器往往已經不在了。
		]
		#P[
			被控端的存活期與它的可見性是反比的，
			這一點與主篇講落腳點那一節是同一件事。
			要講一句的是這個反比關係為什麼成立：
			被控端要在目標機器上長期存在，
			就必須有某些東西是持續的，
			而任何持續的東西都會在日誌或基線裏形成一個穩定的痕跡。
			所以「活得久」這件事本身就有代價，
			不存在既長期存在又完全不可見的做法。
			紅隊能做的只是把這個代價轉移到最不容易被注意的那個地方。
		]
	]

	#H[通道配置與流量偽裝][
		#P[
			被控端與控制端之間的那些可觀察特徵，
			統稱流量配置。
			它改的不是協定，
			而是協定之上那些看起來無關緊要的細節：
			請求的路徑、
			標頭出現的順序、
			連線的間隔分佈、
			以及每次請求和回應的資料大小分佈。
			這些細節之所以重要，
			是因為協定本身往往必須合規，
			而合規之外的部分才是紅隊能操作的地方。
		]
		#P[
			配置的目標是讓這段流量落在目標網路裏某一類正常業務的形狀上。
			選哪一類做模板，
			判斷標準是它在目標網路裏是否必須放行、
			以及它的正常樣本在目標那裏有多少。
			一個每天都大量出現的形狀，
			多一點少一點都不會被注意；
			一個本來就很稀少的形狀，
			紅隊一進來就把自己變成了異類。
			所以模板要選「量大且來源多」的那一類，
			而不是選「看起來最安全」的那一類。
		]
		#P[
			@域前置 是這一層裏的一種具體做法，
			它的原理主篇已經寫過，
			這裡補一句判斷依據：
			它依賴大型內容分發網絡同時承載大量客戶域名這個特性，
			而這個特性近年在多數服務商那裏已經被明確禁止，
			所以判斷它能不能用的依據是服務商當前的策略，
			不是它過去的名聲。
			與它同族的做法是走各類雲服務與協作平臺的介面，
			差別是後者不依賴某一個特性被允許，
			而是依賴某個平臺足夠大、
			流量足夠雜。
			兩者的共同代價是紅隊要依賴一個自己控制不了的第三方。
		]
		#P[
			@重定向器 解決的是另一個問題：
			被控端連的位址與真正處理指令的位址分開。
			這樣做的好處有兩個。
			一是防守方順著流量查到的那台機器上沒有任何東西，
			處置它的時候紅隊只損失一跳；
			二是紅隊可以在不換載荷的情況下更換後端，
			因為被控端記住的位址沒有變。
			代價是多了一跳，
			以及那一跳的位址遲早會被查出來，
			所以它的設計目標是「被發現時損失最小」，
			而不是「不被發現」。
		]
		#P[
			多通道的組織方式有一條實用原則：
			按「防守方要花多大代價才能同時斷掉它們」來分層。
			最外層是日常用的主通道，
			它最容易被發現，
			也最容易被替代；
			中間層是備用通道，
			它平時不活動，
			只在主通道斷掉之後被啟用；
			最內層是那條只負責通知的通道，
			它的流量極小、
			幾乎不可能被注意到，
			但頻寬只夠傳一句話。
			三層的暴露面依次遞減，
			恢復能力依次遞增。
			把所有通道做成同一種形態，
			等於把三層壓成一層。
		]
		#P[
			最後是一個經常被跳過的動作：
			在投遞之前，
			從防守方的位置把這些流量看一遍。
			具體做法是把通道跑起來，
			然後從網路側記錄它產生的全部可觀察特徵，
			包括連線的時間點、
			請與回應的大小、
			以及在任何一層可見的名字。
			看完再問三個問題：
			這樣一段流量如果出現在目標的出口日誌裏，
			它像不像那類正常業務；
			如果不像，
			差在甚麼地方；
			以及這個差別能不能在不改載荷的情況下改掉。
			這一步不需要任何防守方內部的資訊，
			只是換一個位置看自己，
			但它是紅隊在這一層唯一能提前做的驗證。
		]
	]

	#H[簽名、託管與分發][
		#P[
			@代碼簽名 是這三樣裏最容易被高估的一樣。
			它改變的是終端防護對一個檔案的初始判斷：
			一個有有效簽名的檔案，
			在檔案信譽那一層的待遇明顯更好，
			使用者看到的警告也會少。
			但它只影響第一層，
			程式跑起來之後的行為該被發現還是會被發現。
			所以簽名的作用是降低「進門的阻力」，
			不是「進門之後的安全」。
		]
		#P[
			證書的來源有三類，
			演習裏的可用性差別很大。
			第一類是正規的公開代碼簽名證書，
			它有實名審核、
			有簽發紀錄、
			而且一旦被濫用會很快被吊銷，
			用它簽惡意載荷等於把自己的身分寫在檔案上；
			第二類是目標單位自己的簽名證書，
			如果紅隊在演習中途拿到了它，
			那麼用它簽出來的東西在目標環境裏的待遇最好，
			但它同時意味著紅隊已經深入到了相當程度；
			第三類是自簽名，
			它對終端防護基本沒有幫助，
			只能在完全沒有信譽檢查的環境裏起到「看起來像個正式檔案」的作用。
			判斷用哪一類，
			依據是紅隊希望這個檔案在目標那裏看起來是誰發的，
			以及萬一它被公開分析，
			紅隊能不能解釋那張證書的來源。
		]
		#P[
			託管要解決的問題只有一個：
			怎麼讓只有目標那台機器能取到這個檔案。
			放在公網上不設限制，
			等於把自己做的樣本送給所有人，
			包括防守方與別的隊伍。
			常見的做法有幾種，
			它們的差別在於判斷「這是目標」的依據是甚麼：
			按來源位址判斷、
			按一次性的路徑或參數判斷、
			按請求裏帶的某個標識判斷。
			按來源位址判斷最簡單，
			但目標的出口位址可能變化，
			而且同一個位址後面可能不只有目標；
			按一次性路徑判斷更可靠，
			代價是每個目標要單獨準備一份；
			按請求標識判斷最精確，
			但它把判斷邏輯放在了目標那一側，
			一旦載荷被分析，
			這個標識就暴露了。
			三種做法可以疊加，
			原則是「寧可讓某個目標取不到，
			也不要讓不該取到的人取到」。
		]
		#P[
			分發的原則是按目標分開、
			按批次分開、
			每個批次用完即棄。
			按目標分開是為了在一個目標出事的時候不牽連其他目標；
			按批次分開是為了在一個批次被認出來之後，
			後續批次還能用；
			用完即棄是為了讓被分析的那一份失去價值，
			因為防守方拿到的那一份和下一批已經不是同一個東西了。
			三條合起來的代價是準備工作量成倍上升，
			所以實際做法通常只在前幾個關鍵目標上做足，
			其餘目標共用一個批次，
			這個取捨沒有固定答案，
			取決於紅隊手上的時間。
		]
	]

	#H[拿到手裏之後怎麼驗][
		#P[
			驗證要回答四個問題，
			順序不能顛倒：
			能不能跑起來、
			能不能連回來、
			能不能過目標那一層防護、
			能不能活到紅隊需要它活到的時候。
			前兩個問題在自己的實驗環境裏就能回答，
			後兩個只能在目標環境裏回答，
			而它們的答案通常要到投遞之後才知道。
		]
		#P[
			在自己這一側，
			值得做的是三件事。
			一是把載荷放進 @沙箱 跑一遍，
			看它在自動分析環境裏是甚麼表現。
			這一件事的價值有限但要說清楚：
			沙箱裏過得了，
			不代表目標上過得了，
			因為目標的防護產品與沙箱往往不是同一套；
			沙箱裏過不了，
			幾乎可以肯定目標上也過不了。
			所以它的作用是排除，
			不是保證。
		]
		#P[
			二是準備一個對照組。
			拿一個已知會被目標那類防護攔下的東西一起跑，
			用來區分兩件本來很容易混淆的事：
			是防護把載荷攔了，
			還是環境本身就不對。
			沒有對照組的時候，
			紅隊看到「沒反應」只能猜，
			而猜錯的代價是把時間花在改一個本來沒問題的載荷上。
			這一條是這一整塊裏投入產出比最高的做法，
			也是最常被省的。
		]
		#P[
			三是記錄。
			每一次投遞要記下四樣東西：
			時間、
			版本、
			目標、
			結果。
			時間與版本是事後銷毀與追溯的依據；
			目標是判斷「這個版本對哪一類環境有效」的依據；
			結果要分得比「成功」與「失敗」細一些，
			至少要能對上前面那六道關。
			這一件事看起來像文書工作，
			但它在兩個場合會救紅隊：
			演習中途判斷「為甚麼這一週沒有進展」，
			以及演習結束之後證明自己已經處置乾淨。
		]
		#P[
			有三件事不能在這一階段做。
			一是不要在自己單位的辦公環境裏跑，
			哪怕是為了「看一下效果」，
			因為這會在一個真實環境裏留下真實的痕跡，
			而且很可能觸發自己單位的防護；
			二是不要拿目標那台機器當試驗場，
			反覆投遞同一個載荷去試；
			三是不要在載荷還在目標環境裏的時候，
			把它同時放到任何第三方的分析服務上。
			三件都是主篇講 @演習規則 時那條紅線的具體形態。
		]
	]

	#H[用過之後怎麼收][
		#P[
			收尾這件事在演習裏通常排在最後，
			但它出問題的機率不低，
			因為那時候全隊都在趕報告。
			要收的東西有六樣，
			它們的風險等級不一樣。
		]
		#P[
			第一樣是載荷本體，
			包括各個版本與它們的生成配置。
			它的風險是這一整套東西離開 @授權 範圍之後就是違法物品，
			所以它必須有明確的存放位置與銷毀紀錄。
			第二樣是金鑰與證書，
			包括流量加密用的金鑰與簽名用的私鑰。
			憑證被吊銷或者金鑰洩漏，
			都會讓已經投出去的東西失去控制。
			第三樣是託管位址與分發通道，
			它們在演習結束之後如果還活著，
			就等於把一個可用的投遞點留在公網上。
			第四樣是憑據回收通道，
			它同樣是一個還在運作的接收端。
			第五樣是控制端的資料，
			包括被控端回報的目標環境資訊，
			這裡面很可能含真實的業務資料，
			而它能不能複製出來、
			演習結束後要不要銷毀，
			@授權 那一項通常有明確約定。
			第六樣是操作日誌，
			它是唯一一樣不但不能銷毀、
			還要妥善保存的東西，
			因為它是 @舉證與報告 的材料。
		]
		#P[
			這裡有一個必須分清的區別：
			@痕跡清理 是清理目標機器上留下的東西，
			收尾是收回自己這一側的東西。
			兩件事經常被混在一起做，
			混在一起的後果是其中一件必然做不乾淨。
			目標那一側的清理要與舉證的需要一起考慮，
			這條取捨主篇已經寫過；
			自己這一側的收尾則沒有這個顧慮，
			標準只有一條：
			離開演習之後，
			這些東西不能再有任何可用的部分。
			兩件事的判斷標準不同，
			所以要分開做、
			分開檢查。
		]
		#P[
			收尾還有一件事是交接。
			演習結束之後，
			紅隊手上的目標環境資訊、
			通道位址、
			以及被控端的識別特徵，
			對防守方是有用的：
			它讓對方知道自己的環境裏曾經有過甚麼。
			這一部分通常在報告裏以描述的方式給出，
			而不是把樣本本身交給對方。
			交不交、
			交到甚麼程度，
			取決於 @演習規則 與組織方的要求，
			不由紅隊自己決定。
		]
	]

	#H[痕跡：防守方在每一層看到甚麼][
		#P[
			這一節是前面幾節的鏡像，
			目的是讓紅隊在做的時候就知道對面在看甚麼。
			按層從外往裏排，
			能看到東西的順序大致是郵件、
			網路、
			終端、
			伺服器。
		]
		#P[
			郵件那一層看到的是誘餌。
			能看到的包括寄件人的信譽、
			發信域的認證結果、
			附件的類型與結構、
			連結指向域名的年齡、
			以及同一批郵件之間的相似度。
			這一層看不到載荷的內容，
			所以它攔的是「這封郵件像不像正常的信」。
		]
		#P[
			網路那一層看到的是通道。
			能看到的包括連線的目標位址與端口、
			連線的時間分佈、
			請求和回應的大小分佈、
			以及 TLS 連線外層的那些欄位。
			這一層看不到被控端在做甚麼，
			所以它攔的是「這段流量像不像正常業務」。
			主篇講 @隱蔽通道 那一節講的就是怎麼讓自己更像一點。
		]
		#P[
			終端那一層看到的是加載器與被控端本身。
			這一層能看到的東西最多：
			檔案是甚麼時候出現的、
			它是被哪個程式帶來的、
			是哪個程式把它叫起來的、
			它有沒有對別的進程做記憶體操作、
			它有沒有建立一個不該有的子程序、
			以及它的命令列參數是甚麼。
			這也正是 @端點偵測與回應 的四個維度。
			紅隊要記住的一個結論是：
			不落地的做法在檔案那一層最乾淨，
			但它在行為那一層的痕跡最重，
			兩者不能同時乾淨。
		]
		#P[
			伺服器那一層看到的是後果。
			網頁應用那一頭看到的是被寫入的檔案與異常的請求；
			系統那一頭看到的是新的帳號、
			新的服務、
			以及被改動的設定。
			這一層的痕跡往往是防守方最早注意到的，
			因為它與業務直接相關。
		]
		#P[
			四層合起來的判斷標準是：
			紅隊的每一步都會在某一層留下痕跡，
			能做的是選擇留在哪一層，
			以及讓那一層的痕跡落在最不容易被注意的地方。
			主張某一個做法「沒有痕跡」的說法都是錯的，
			任何一個載荷要在目標上產生作用，
			就必然要有某些東西發生變化，
			而那些變化都可以被記錄。
		]
	]

	#H[紅線：哪些東西絕對不能用][
		#P[
			主篇已經把演習的紅線寫過一遍，
			這一節只寫與武器和載荷直接相關的那幾條，
			因為它們在這一塊最容易越過。
		]
		#P[
			第一條是不用來路不明的樣本。
			這一條前面已經寫過理由，
			這裡補一點：
			除了法律與不可控的問題，
			它還會讓紅隊在事後無法回答「你投的到底是甚麼」，
			而這個問題在演習總結與任何一次事故調查裏都必然被問到。
		]
		#P[
			第二條是不對 @授權 範圍之外的位址投放。
			這一條在釣魚上特別容易出錯，
			因為釣魚是投給人的，
			而人可能已經離職、
			可能調到了別的單位、
			也可能用的是個人信箱。
			所以投遞清單在發出之前要與授權範圍核對一次，
			核對不上的先停手，
			按主篇講的原則向聯絡人書面確認。
		]
		#P[
			第三條是不造成不可逆的變更。
			載荷這一塊最容易越過的地方是加密。
			凡是把目標的檔案加密、
			把資料庫的表結構改掉、
			或者把某個服務的設定覆蓋掉的做法，
			即使技術上完全成功，
			在規則上都屬於不可逆變更。
			這一條與 @1day與Nday 那一類判斷無關，
			與 @弱點 的類型也無關，
			它只看後果能不能還原。
		]
		#P[
			第四條是不把真實業務資料帶走。
			前面講被控端的時候已經把回報與外傳分開了，
			這裡再強調一次判斷方法：
			紅隊需要的是能證明自己達到過某個位置的憑據，
			所以取樣要取能自證的那一部分，
			而不是取全量。
			全量資料既沒有額外的舉證價值，
			又直接落在規則禁止的那一類上。
		]
		#P[
			第五條是不把演習產物用於演習之外。
			這一條看起來是多餘的，
			但它是這一整塊裏唯一一條一旦違反就無法補救的。
			載荷、
			金鑰、
			通道位址、
			以及拿到手的憑據，
			它們在授權時間窗之內是工具，
			出了那個窗口就是另一回事，
			而這個轉換髮生在演習結束的那一刻，
			不取決於紅隊當時在做甚麼。
		]
	]

	#H[常見的失敗模式][
		#P[
			把前面幾節裏散落的坑收在一起，
			按出現頻率從高到低排。
			每一條都給了判斷方法，
			因為這些失敗的共同特徵是「當時看起來不像失敗」。
		]
		#P[
			第一，投遞成功之後一直沒有回連，
			紅隊反覆改載荷的行為層特徵。
			判斷方法是用對照組區分兩種可能：
			如果對照組能在目標環境裏產生可觀察的動作，
			說明環境是通的，
			問題在防護；
			如果對照組也沒有任何反應，
			說明問題在出網或環境檢查，
			改行為層沒用。
		]
		#P[
			第二，載荷在實驗環境裏一直好好的，
			到了目標上就是不啟動。
			原因是環境檢查寫得太嚴。
			判斷方法是在一台與目標同類的授權機器上跑一次，
			如果同樣不啟動，
			那就是環境檢查的問題，
			而不是防護的問題。
		]
		#P[
			第三，通道通了幾天之後突然全斷。
			最常見的原因是幾條通道共用了同一個域名或同一組位址，
			防守方處置一次就全沒了。
			判斷方法是事前檢查通道之間的共用項，
			共用項越少越好。
		]
		#P[
			第四，載荷被別人先取走。
			原因是託管位址沒有做取用限制。
			判斷方法是從一台與目標無關的機器上試著取一次，
			取得到就說明限制沒生效。
		]
		#P[
			第五，同一個目標上第二次投遞就被認出來。
			原因是同一版載荷在同一個目標上用了兩次。
			判斷方法是在投遞記錄裏檢查版本與目標的對應關係，
			這也正是前面要求記版本的原因。
		]
		#P[
			第六，心跳被基線挑出來。
			原因是間隔太規律。
			判斷方法是把通道的連線時間點畫出來看一遍，
			自己看不出節律才算合格。
		]
		#P[
			第七，演習結束之後說不清自己投過甚麼、
			投給了誰。
			原因是沒有版本清單。
			判斷方法是在第一次投遞之前就把清單建好，
			這件事沒有事後補救的辦法。
		]
		#P[
			第八，把載荷留在了自己單位的環境裏。
			原因是在辦公室裏「順手試一下」。
			判斷方法是在收尾清單裏把研發環境、
			測試環境、
			個人設備三處各查一遍。
		]
	]

	#H[小結][
		#P[
			把這一篇壓成幾句話。
			紅隊手上的東西分三層，
			誘餌、
			加載器、
			被控端，
			三層的壽命與痕跡位置都不同，
			所以投入與更新的節奏也不同。
			東西的來源有四條，
			其中來路不明的樣本一條都不能用，
			其餘三條的取捨標準是「防守方能不能把它寫成規則」。
			一個載荷要連續過六道關，
			失敗的時候先定位關口，
			再決定改哪一層，
			這是這一塊最省時間的做法。
			最後，
			演習結束的時候要能證明兩件事：
			投出去的都收乾淨了，
			以及自己每一步都留了能自證的材料。
		]
		#P[
			這一篇與其餘幾篇的接口有三處。
			加載器與被控端在終端上的痕跡，
			進一步的展開在終端對抗那一篇；
			誘餌與投遞那一半在釣魚那一篇；
			通道所依賴的跳板、
			域名與服務端在紅隊基礎設施那一篇。
			三篇都寫完之後，
			這一篇可以只留機制與判斷，
			把工具與參數交給它們。
		]
		#P[
			還有一句要放在最後。
			這一篇寫的每一件事都以 @授權 為前提，
			而且這裡的授權要求比別的環節更高，
			因為它是唯一一個會在自己手上留下可用攻擊工具的環節。
			沒有授權而做同樣的事，
			性質與演習無關。
		]
	]

