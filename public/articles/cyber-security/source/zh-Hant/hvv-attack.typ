#let ColorTermBar = ColorQuoteLeftBorder  // 詞條左側豎線：#008888
#let ColorTermLink = ColorRefText          // 鏈接：#00cccc
// 所有詞條都排在這一個錨點底下（HTML 靶詞條兜底鏈接的落點）。
#let TermListId = "術語表"

// ── 框架：概念鏈 ──
// 兩件事現在都在 _Common.typ 裏，多篇文章共用：
// 詞條工廠 MkTerm（兩靶同構的包裹、概念登記）、
// 概念引用的渲染（_Common.typ 的 show ref，靠登記表認出概念引用）。
// 本檔只留 R：概念鏈規約裏「引用後文纔登記的條目」用的包裝，
