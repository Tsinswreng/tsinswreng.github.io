#import "../_Common.typ": *
#import "./Keyboard.typ": Keyboard_AltNav
#show: _Show

#let ImgGen = FnImgGen("AltNav/assets/")
#let Img = ImgPath.with(Base: "AltNav")

#_Document("AltNav.pdf")[
	#title[AltNav:用左Alt把鍵盤中心區變成方向鍵]

	#P[
		AltNav爲基于AutoHotkey2實現的方向鍵映射腳本,
		受Vim方向鍵設計啓發,
		通過`左Alt`鍵結合其他按鍵來實現方向移動/光標跳轉,
		使您的手不用離開鍵盤中心區域。
	]

	//#let Target = ""
	#let Keyboard_AltNav = if Target == TargetPdf {
		Keyboard_AltNav
	} else {
		//image("./assets/Keyboard_AltNav.gen.svg")
		ImgGen("Keyboard_AltNav")
	}


	#H[映射][
		#figure(
			Keyboard_AltNav,
			caption: [鍵位圖],
		)
		- #[按住`左Alt`時,
				`J`、`K`、`L`、`;`鍵分別映射爲 `←`、`↓`、`↑`、`→`鍵。]
		- #[按住`左Alt`時,
				`N`、`M`、`,`、`.`鍵分別映射爲連續4次的 `←`、`↓`、`↑`、`→`。]
		- #[按住`左Alt`與`Ctrl`時,
				`N`、`M`、`,`、`.`鍵分別映射連續16次的 `←`、`↓`、`↑`、`→`。]
		- #[`左Alt`+`I` → 光標移動到行首]
		- #[`左Alt`+`O` → 光標移動到行末]
		- #[光標移至文件首
				- `Ctrl`+`左Alt`+`I` → `Ctrl`+`Home`
			]
		- #[光標移至文件尾
				- `Ctrl`+`左Alt`+`O` → `Ctrl`+`End`
			]

			所有光標移動映射均支持按住`Shift`鍵選中文本,
			如`Shift`+`左Alt`+`J`即光標向左選中一個字符。
			在行爲上與常規的`Shift`+方向鍵相同。
	]

	#H[特點][
		- #[編輯文本時光標快速跳轉,
				雙手不用離開鍵盤中心區,
				不需依賴鼠標
			]
		- #[結合`左Alt`鍵觸發,
				不需區分閱讀模式或編輯模式等,
				不影響正常輸出
			]
		- #[快捷鍵映射爲全局生效,
				不止局限于某一應用
			]
		- #[移动步長分爲 1、4、16 三檔,
			兼顧精確與快速定位
		]
	]

	#H[安裝][
		- Windows平臺
		- 依賴 AutoHotkey2
		- 在權限更高的程序上輸入則需要用管理員運行此腳本。
	]



	#H[設計哲學][
		#H[按鍵選取][
			#P[
				`JKL;`參照了Vim的方向鍵設計。
				但Vim原先的方向鍵順序是`H`、`J`、`K`、`L` 分別對應`左`、`下`、`上`、`右`。
				但一般手指搭在鍵盤上時,
				右手食指是放在`J`鍵上的。
				若要保持右手食指放在`J`鍵上不動,
				同時放四根手指在四個鍵上、則只有`JKL;`最適合。
				#Img("assets/2026-08-20-16-36-34.png")
			]
			
			#P[
				設計`Home`/`End`的映射時,
				有兩種方案。
				方案A是當前採用的方案,
				即`左Alt`+`I`/`O`;
				方案B是`左Alt`+`H`/`'`。
			]
			
			#P[
				方案B在語義上更佳,
				`Home`,`←`,`↓`,`↑`,`→`,`End`成一線。
				但最終仍然選擇了方案A。
				因右手食指放在`J`鍵上時,
				中指無名指會分別自然蜷縮在`I`/`O`上,
				按起來更舒服;
				且文本編輯中`Home`/`End`仍是高頻使用的功能,
				中指/無名指的組合 力量大於食指/小指。
			]
		]

		#H[方向順序][
			#P[
				方向順序方面,
				之所以選擇了`左,下,上,右`順序,
				這樣設計有兩個好處:
				+ #[順序和Vim保持一致(但其實在設計出這套方向映射之前,
						本人並沒有接觸過Vim風格的方向鍵,
						也沒有相應的習慣或肌肉記憶。)];
				+ #[下、上 鍵 分別由 中指 和 無名指 負責。
						這兩根手指按壓力量較大,
						適合頻繁上下跳行翻閱內容的場景]

				也有兩個壞處:
				+ #[右方向鍵 使用頻率更高但由力量小拇指負責]
				+ #[這個順序乍一看有點反直覺。
						按方向來分類,
						四鍵方向鍵一共可以分出 橫向 和 縱向 兩個維度。
						`左`,`下`,`上`,`右`的方案規律性不強。
						若按`左`,`右`,`上`,`下`這樣橫向和縱向各自排列在一起的順序看起來更直覺一些。
					]
			]
		]

		#H[長距移動][
			#P[快速移動時,
				腳本提供 1、4、16 三種步長。
				每一級都是前一級的 4 倍,
				一次較大的移動可以替代 4 次較小的移動。
				任意移動距離都可以用 ±1、±4、±16 組合出來。
				這相當於用四進位分解移動距離：每個較大的步長都能減少總擊鍵次數，同時保留單步移動提供的精確性。
			]
			
			#P[
				在鍵位選取上,
				從`JKL;`到`NM,.`相當於上下平移,
				同一列保持同一方向,
				上排負責單步,
				下排負責4步,
				再按住`Ctrl`則放大爲16步。
			]
		]
	]
	
	#H[已知問題][
		在遠程控制軟件/虛擬機下時此腳本可能不能正常工作
	]
]
