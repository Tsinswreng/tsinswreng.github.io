#import "_ConceptChain.typ":*
// ── 概念鏈：登記順序 = 閱讀順序 ──
// 強烈建議按照先聲明後引用的順序，不要前向引用搞亂順序
// 引用已登記的條目直接寫 @名字（用得最多）
// 引用後文才登記的條目寫 #R[@名字]（不建議）
// @名字後須跟空格或標點（@會吞緊隨的漢字）

#let Terms = [
	#MkR[染色體][
		染色體是細胞核內由 DNA 和蛋白質組成的結構，
		人有 23 對共 46 條。

	]<染色體>

	#MkR[染色單體][
		染色單體是 @染色體 複製的產物：
		複製之後，
		每條 @染色體 含有兩條染色單體，
		兩條互稱姐妹染色單體，
		由 @着絲粒 連接在一起。
	]<染色單體>

	#MkR[着絲粒][
		着絲粒是 @染色體 上縊縮、
		連接兩條姐妹 @染色單體 的部位。
	]<着絲粒>

	#MkR[同源染色體][
		同源染色體是配對的兩條 @染色體 ：
		形狀和大小一般都相同，
		一條來自父方、一條來自母方。
		人體細胞中的 23 對 @染色體 ，
		每一對都是同源染色體。

		（減數分裂中他們如何兩兩配對，
		見 #R[@聯會] 。）
	]<同源染色體>

	#MkR[聯會][
		聯會指減數分裂過程中，
		@同源染色體 兩兩配對的現象。
	]<聯會>

	#MkR[四分體][
		四分體是 @聯會 後的結構：
		由於每條 @染色體 都含有兩條姐妹 @染色單體 ，
		聯會後的每對 @同源染色體 都含有四條 @染色單體 ，
		所以叫作四分體。
	]<四分體>

	#MkR[交叉互換][
		交叉互換指 @四分體 時期，
		非姐妹 @染色單體 之間發生交叉、
		相互交換一部分片段的現象。
	]<交叉互換>

	#MkR[減數第一次分裂][
		減數第一次分裂中，
		紡錘絲牽引聯會的 @同源染色體 彼此分開，
		分別進入兩個子細胞；
		此時 @着絲粒 不分裂，
		姐妹 @染色單體 仍然相連，
		染色體數目就此減半。
	]<減數第一次分裂>

	#MkR[減數第二次分裂][
		減數第二次分裂緊隨 @減數第一次分裂 ，
		基本過程與有絲分裂相似：
		@着絲粒 一分爲二，
		姐妹 @染色單體 分開，
		成爲兩條獨立的 @染色體 ，
		細胞隨之分裂，
		產生四個精細胞。
	]<減數第二次分裂>

	#MkR[減數分裂][
		減數分裂是進行有性生殖的生物，
		在產生成熟生殖細胞時進行的染色體數目減半的細胞分裂：
		減數分裂前 @染色體 複製一次，
		細胞連續分裂兩次，
		兩輪即 @減數第一次分裂 與 @減數第二次分裂 ；
		成熟的生殖細胞 @染色體 數目比原始生殖細胞的減少一半。
	]<減數分裂>
]

#Terms

// 以下是正文
以精子的形成爲例。
減數分裂開始之前，
精原細胞的每條 @染色體 先複製一次；
複製之後，
每條 @染色體 含有兩條姐妹 @染色單體 ，
兩條由 @着絲粒 連接在一起；

減數第一次分裂前期，
@同源染色體 兩兩配對，
這一現象叫 @聯會 ；
聯會後，
每對 @同源染色體 含有四條 @染色單體 ，
叫 @四分體 ；
這一時期，
非姐妹 @染色單體 之間常發生 @交叉互換 ，
相互交換一部分片段。

隨後，
紡錘絲牽引聯會的 @同源染色體 彼此分開，
分別進入兩個子細胞，
這是 @減數第一次分裂 ；
此時 @着絲粒 不分裂，
染色體數目就此減半。

進入 @減數第二次分裂 ，
兩個子細胞不再複製染色體，
@着絲粒 一分爲二，
姐妹 @染色單體 分開，
成爲兩條獨立的 @染色體 ，
細胞再分裂一次，
最終得到四個精細胞。
@減數分裂 的結果是，
成熟生殖細胞中的 @染色體 數目比原始生殖細胞的減少一半。



