---
interface Props {
  pdfUrl: string;
  title: string;
}

const { pdfUrl, title } = Astro.props;
---

<section class="pdf-viewer" data-pdf-url={pdfUrl} aria-label={`${title} PDF 閱讀器`}>
  <div class="pdf-toolbar">
    <div class="pdf-page-controls" aria-label="頁面控制">
      <button type="button" class="pdf-button" data-action="previous" disabled>上一頁</button>
      <span class="pdf-page-status" aria-live="polite">正在載入 PDF…</span>
      <button type="button" class="pdf-button" data-action="next" disabled>下一頁</button>
    </div>
    <div class="pdf-zoom-controls" aria-label="縮放控制">
      <button type="button" class="pdf-button" data-action="zoom-out" disabled aria-label="縮小">－</button>
      <span class="pdf-zoom-status">100%</span>
      <button type="button" class="pdf-button" data-action="zoom-in" disabled aria-label="放大">＋</button>
    </div>
  </div>
  <div class="pdf-canvas-area">
    <canvas class="pdf-canvas"></canvas>
    <p class="pdf-error" hidden></p>
    <button type="button" class="pdf-button pdf-retry" data-action="retry" hidden>重新載入</button>
  </div>
</section>

<script>
  import * as pdfjsLib from "pdfjs-dist/build/pdf.mjs";
  import workerUrl from "pdfjs-dist/build/pdf.worker.mjs?url";

  pdfjsLib.GlobalWorkerOptions.workerSrc = workerUrl;

  for (const viewer of document.querySelectorAll<HTMLElement>(".pdf-viewer")) {
    const pdfUrl = viewer.dataset.pdfUrl;
    const canvas = viewer.querySelector<HTMLCanvasElement>(".pdf-canvas");
    const canvasArea = viewer.querySelector<HTMLElement>(".pdf-canvas-area");
    const pageStatus = viewer.querySelector<HTMLElement>(".pdf-page-status");
    const zoomStatus = viewer.querySelector<HTMLElement>(".pdf-zoom-status");
    const errorMessage = viewer.querySelector<HTMLElement>(".pdf-error");
    const previousButton = viewer.querySelector<HTMLButtonElement>("[data-action='previous']");
    const nextButton = viewer.querySelector<HTMLButtonElement>("[data-action='next']");
    const zoomOutButton = viewer.querySelector<HTMLButtonElement>("[data-action='zoom-out']");
    const zoomInButton = viewer.querySelector<HTMLButtonElement>("[data-action='zoom-in']");
    const retryButton = viewer.querySelector<HTMLButtonElement>("[data-action='retry']");

    if (!pdfUrl || !canvas || !canvasArea || !pageStatus || !zoomStatus || !errorMessage || !previousButton || !nextButton || !zoomOutButton || !zoomInButton || !retryButton) continue;

    let pdf: any;
    let currentPage = 1;
    let scale = 1;
    let renderTask: any;

    const updateControls = () => {
      previousButton.disabled = currentPage <= 1;
      nextButton.disabled = currentPage >= pdf.numPages;
      zoomOutButton.disabled = scale <= 0.5;
      zoomInButton.disabled = scale >= 2.5;
      pageStatus.textContent = `第 ${currentPage}／${pdf.numPages} 頁`;
      zoomStatus.textContent = `${Math.round(scale * 100)}%`;
    };

    const renderPage = async () => {
      renderTask?.cancel();
      const page = await pdf.getPage(currentPage);
      const baseViewport = page.getViewport({ scale: 1 });
      const availableWidth = Math.max(280, canvasArea.clientWidth - 32);
      const fittedScale = Math.min(availableWidth / baseViewport.width, 1.35);
      const viewport = page.getViewport({ scale: fittedScale * scale });
      const outputScale = window.devicePixelRatio || 1;
      const context = canvas.getContext("2d", { alpha: false });
      if (!context) throw new Error("無法建立 PDF 繪圖畫面。");

      canvas.width = Math.floor(viewport.width * outputScale);
      canvas.height = Math.floor(viewport.height * outputScale);
      canvas.style.width = `${Math.floor(viewport.width)}px`;
      canvas.style.height = `${Math.floor(viewport.height)}px`;
      context.setTransform(outputScale, 0, 0, outputScale, 0, 0);
      renderTask = page.render({ canvasContext: context, viewport });
      await renderTask.promise;
      updateControls();
    };

    const loadPdf = async () => {
      errorMessage.hidden = true;
      retryButton.hidden = true;
      pageStatus.textContent = "正在載入 PDF…";
      const response = await fetch(pdfUrl, { cache: "no-store" });
      if (!response.ok) throw new Error(`PDF 請求失敗：${response.status}`);
      const data = new Uint8Array(await response.arrayBuffer());
      pdf = await pdfjsLib.getDocument({ data }).promise;
      await renderPage();
    };

    retryButton.addEventListener("click", () => void loadPdf().catch(showError));

    try {
      await loadPdf();
      previousButton.addEventListener("click", async () => {
        if (currentPage > 1) {
          currentPage -= 1;
          await renderPage();
        }
      });
      nextButton.addEventListener("click", async () => {
        if (currentPage < pdf.numPages) {
          currentPage += 1;
          await renderPage();
        }
      });
      zoomOutButton.addEventListener("click", async () => {
        scale = Math.max(0.5, scale - 0.2);
        await renderPage();
      });
      zoomInButton.addEventListener("click", async () => {
        scale = Math.min(2.5, scale + 0.2);
        await renderPage();
      });
      window.addEventListener("resize", () => void renderPage());
    } catch (error) {
      showError(error);
    }

    function showError(error: unknown) {
      console.error(error);
      pageStatus.textContent = "PDF 載入失敗";
      errorMessage.hidden = false;
      errorMessage.textContent = "PDF 暫時無法載入。";
      retryButton.hidden = false;
    }
  }
</script>
