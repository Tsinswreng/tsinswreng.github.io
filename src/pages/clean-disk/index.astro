---
import SiteLayout from "../../layouts/SiteLayout.astro";
import articleHtmlSource from "../../../public/clean-disk.html?raw";

const articleHtml = articleHtmlSource.match(/<body[^>]*>([\s\S]*)<\/body>/i)?.[1] ?? articleHtmlSource;
---

<SiteLayout
  title="用目錄鏈接讓 C 盤騰出空間｜Tsinswreng"
  description="用目錄鏈接讓 C 盤騰出空間。"
>
  <article class="article-shell">
    <header class="article-heading">
      <h2>用目錄鏈接讓 C 盤騰出空間</h2>
      <p>Windows 磁碟空間整理方法。</p>
    </header>
    <div class="article-body" set:html={articleHtml}></div>
  </article>
</SiteLayout>
